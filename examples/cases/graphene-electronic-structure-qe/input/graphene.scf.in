&CONTROL
  calculation = 'scf',
  prefix = 'graphene',
  outdir = './tmp',
  pseudo_dir = './pseudo',
  tstress = .false.,
  tprnfor = .false.
/
&SYSTEM
  ibrav = 0,
  nat = 2,
  ntyp = 1,
  ecutwfc = 50.0,
  ecutrho = 400.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.01,
  nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-10,
/
ATOMIC_SPECIES
C 12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
C 0.000000000000 0.000000000000 0.500000000000
C 0.333333333333 0.666666666667 0.500000000000
K_POINTS automatic
18 18 1 0 0 0
CELL_PARAMETERS angstrom
 2.460000000  0.000000000  0.000000000
-1.230000000  2.130422493  0.000000000
 0.000000000  0.000000000 20.000000000
