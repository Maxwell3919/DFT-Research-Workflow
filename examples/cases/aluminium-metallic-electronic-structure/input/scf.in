&CONTROL
  calculation = 'scf'
  prefix = 'al'
  pseudo_dir = './pseudo'
  outdir = './tmp'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.653
  nat = 1
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Al  26.9815385  Al.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Al  0.0 0.0 0.0
K_POINTS automatic
  8 8 8 0 0 0
