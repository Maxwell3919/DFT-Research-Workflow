[
  {"id":"define-question","stage":"frame","title":"提出可证伪问题","summary":"把研究动机压缩为能被计算结果支持、限制或否定的问题。","inputs":["research context","candidate mechanism"],"outputs":["falsifiable question"],"prerequisites":[],"convergence_axes":[],"validation_gates":["alternative explanations recorded","decision consequence stated"],"supported_tools":["literature map","decision log"],"automation_maturity":"manual","evidence_boundary":"问题清楚不代表所选计算能够回答它。"},
  {"id":"define-observable","stage":"frame","title":"定义目标 observable","summary":"说明真正比较的物理量、单位、参考态、符号和统计口径。","inputs":["falsifiable question"],"outputs":["observable specification"],"prerequisites":["define-question"],"convergence_axes":["target precision"],"validation_gates":["units fixed","reference state fixed"],"supported_tools":["equation editor","metadata schema"],"automation_maturity":"assisted","evidence_boundary":"定义 observable 不证明当前方法能可靠预测它。"},
  {"id":"acceptance-criteria","stage":"frame","title":"预先声明接受标准","summary":"在看到结果前定义数值、物理和科学层面的判定门。","inputs":["observable specification"],"outputs":["acceptance matrix"],"prerequisites":["define-observable"],"convergence_axes":["decision tolerance"],"validation_gates":["technical and scientific gates separated"],"supported_tools":["decision table"],"automation_maturity":"manual","evidence_boundary":"阈值本身仍需科学依据，不能任意设定。"},
  {"id":"literature-boundary","stage":"frame","title":"建立文献与知识边界","summary":"区分直接数据、作者解释、综合推断和仍未知的问题。","inputs":["question","primary sources"],"outputs":["source map","open questions"],"prerequisites":["define-question"],"convergence_axes":[],"validation_gates":["primary sources distinguished","version-sensitive claims checked"],"supported_tools":["DOI index","reference manager"],"automation_maturity":"assisted","evidence_boundary":"多篇文献重复同一主张不自动构成独立验证。"},
  {"id":"acquire-structure","stage":"structure","title":"获取来源结构","summary":"从可追溯来源获取结构，并保留原始标识、版本和获取时间。","inputs":["structure source"],"outputs":["source structure","provenance record"],"prerequisites":["define-question"],"convergence_axes":[],"validation_gates":["source identity retained","license boundary checked"],"supported_tools":["CIF","POSCAR","ASE","pymatgen"],"automation_maturity":"assisted","evidence_boundary":"来源可信不保证结构适用于目标温压、相或化学环境。"},
  {"id":"normalize-structure","stage":"structure","title":"规范化结构表示","summary":"统一晶胞、坐标、元素标签、占位和周期边界，同时记录每次变换。","inputs":["source structure"],"outputs":["normalized structure","transform log"],"prerequisites":["acquire-structure"],"convergence_axes":["cell representation"],"validation_gates":["composition preserved","round-trip checked"],"supported_tools":["spglib","ASE","pymatgen"],"automation_maturity":"candidate","evidence_boundary":"几何格式通过不证明无序、缺陷或实验占位已被正确建模。"},
  {"id":"inspect-symmetry","stage":"structure","title":"检查对称性与周期像","summary":"在明确 tolerance 下审查空间群、等价位点、近邻和周期像。","inputs":["normalized structure"],"outputs":["symmetry report","neighbor audit"],"prerequisites":["normalize-structure"],"convergence_axes":["symmetry tolerance"],"validation_gates":["tolerance sensitivity checked","unexpected contacts reviewed"],"supported_tools":["spglib","SeeK-path","structure viewer"],"automation_maturity":"assisted","evidence_boundary":"识别出的高对称性可能被真实畸变、磁序或数值容差打破。"},
  {"id":"enumerate-configurations","stage":"structure","title":"枚举构型与初态","summary":"为缺陷、吸附、磁序、堆垛或合金建立有边界的候选集合。","inputs":["normalized structure","research question"],"outputs":["configuration set"],"prerequisites":["inspect-symmetry"],"convergence_axes":["configuration coverage"],"validation_gates":["duplicates removed","selection rule documented"],"supported_tools":["enumlib","ASE","pymatgen"],"automation_maturity":"assisted","evidence_boundary":"有限枚举没有证明已经找到全局最低能态。"},
  {"id":"choose-model","stage":"structure","title":"选择物理模型","summary":"决定体相、表面、二维、缺陷、界面或分子边界以及需要显式保留的自由度。","inputs":["configuration set","observable specification"],"outputs":["physical model"],"prerequisites":["define-observable","enumerate-configurations"],"convergence_axes":["model size","vacuum","defect separation"],"validation_gates":["boundary artifacts anticipated","charge and stoichiometry explicit"],"supported_tools":["model checklist"],"automation_maturity":"manual","evidence_boundary":"更大的模型不自动更真实；缺失的环境物理可能仍主导误差。"},
  {"id":"select-code","stage":"protocol","title":"选择代码与版本","summary":"根据目标方法、性质实现、边界条件和可验证性选择版本绑定的软件。","inputs":["physical model","observable specification"],"outputs":["code identity"],"prerequisites":["choose-model"],"convergence_axes":[],"validation_gates":["feature availability verified","version recorded"],"supported_tools":["Quantum ESPRESSO","VASP","CP2K","SIESTA"],"automation_maturity":"manual","evidence_boundary":"软件支持某功能不代表默认设置适合当前研究。"},
  {"id":"select-pseudopotential","stage":"protocol","title":"选择赝势或基组","summary":"匹配元素、价电子、相对论处理、泛函和目标压力/性质。","inputs":["code identity","chemical species"],"outputs":["potential or basis identities"],"prerequisites":["select-code"],"convergence_axes":["basis size","semicore choice"],"validation_gates":["hashes recorded","compatibility checked","benchmark need assessed"],"supported_tools":["SSSP","PseudoDojo","BASIS_MOLOPT"],"automation_maturity":"assisted","evidence_boundary":"库级推荐不替代材料和 observable 相关的 transferability 检验。"},
  {"id":"select-functional","stage":"protocol","title":"选择交换关联与修正","summary":"把 functional、色散、U、混合泛函或 SOC 选择连接到材料物理与目标量。","inputs":["literature boundary","observable specification"],"outputs":["method rationale"],"prerequisites":["literature-boundary","select-code"],"convergence_axes":["method sensitivity"],"validation_gates":["assumptions stated","parameter provenance recorded"],"supported_tools":["DFT","DFT+U","hybrid DFT","SOC"],"automation_maturity":"manual","evidence_boundary":"常用方法或与文献一致不等于对当前体系准确。"},
  {"id":"define-boundary-conditions","stage":"protocol","title":"定义边界与校正","summary":"明确周期性、真空、偶极、带电体系、场和约束条件。","inputs":["physical model","code identity"],"outputs":["boundary specification"],"prerequisites":["choose-model","select-code"],"convergence_axes":["vacuum","cell size","correction model"],"validation_gates":["periodic artifacts tested","reference convention recorded"],"supported_tools":["slab correction","charged-cell correction","Coulomb cutoff"],"automation_maturity":"assisted","evidence_boundary":"数值校正依赖其推导假设，不能自动恢复缺失的真实环境。"},
  {"id":"establish-kpoints","stage":"convergence","title":"收敛 k/q 采样","summary":"对目标 observable 收敛倒空间网格、路径或积分采样。","inputs":["protocol","observable specification"],"outputs":["sampling evidence"],"prerequisites":["select-functional","define-boundary-conditions"],"convergence_axes":["k density","q density","offset","path"],"validation_gates":["observable delta below target","metallic sensitivity checked"],"supported_tools":["Monkhorst-Pack","SeeK-path"],"automation_maturity":"candidate","evidence_boundary":"总能收敛不保证费米面、声子或响应函数收敛。"},
  {"id":"establish-cutoff","stage":"convergence","title":"收敛基组截断","summary":"联合检查波函数、密度、网格或实空间精度对目标量的影响。","inputs":["potential identities","observable specification"],"outputs":["cutoff evidence"],"prerequisites":["select-pseudopotential"],"convergence_axes":["wavefunction cutoff","density cutoff","grid spacing"],"validation_gates":["observable delta below target","stress or force included when relevant"],"supported_tools":["plane-wave sweep","real-space grid sweep"],"automation_maturity":"candidate","evidence_boundary":"单元素推荐截断不自动覆盖多组分、应力或高压性质。"},
  {"id":"establish-smearing","stage":"convergence","title":"收敛占据与展宽","summary":"区分积分辅助展宽与物理电子温度，并检查能量、力和态密度敏感性。","inputs":["electronic character","observable specification"],"outputs":["occupation evidence"],"prerequisites":["select-functional"],"convergence_axes":["smearing type","smearing width"],"validation_gates":["entropy convention recorded","metal and insulator routes distinguished"],"supported_tools":["Fermi-Dirac","Methfessel-Paxton","tetrahedron"],"automation_maturity":"assisted","evidence_boundary":"SCF 更稳定不代表展宽带来的物理偏差可接受。"},
  {"id":"establish-supercell","stage":"convergence","title":"收敛模型尺寸","summary":"检查超胞、真空、缺陷间距、位移幅度或相关长度尺度。","inputs":["physical model","observable specification"],"outputs":["finite-size evidence"],"prerequisites":["define-boundary-conditions"],"convergence_axes":["supercell dimensions","vacuum","displacement amplitude"],"validation_gates":["image interaction bounded","symmetry changes reviewed"],"supported_tools":["supercell generator","finite-size scaling"],"automation_maturity":"candidate","evidence_boundary":"一个大超胞不足以展示有限尺寸误差趋势。"},
  {"id":"relaxation","stage":"convergence","title":"验证结构优化协议","summary":"分别控制力、应力、能量、晶胞和对称约束，并检查多初态。","inputs":["physical model","converged numerical settings"],"outputs":["relaxed candidates","relaxation lineage"],"prerequisites":["establish-kpoints","establish-cutoff","establish-supercell"],"convergence_axes":["force threshold","stress threshold","optimizer","initial state"],"validation_gates":["termination reason parsed","constraints audited","competing minima compared"],"supported_tools":["ionic optimizer","cell optimizer"],"automation_maturity":"assisted","evidence_boundary":"达到几何阈值只说明局部优化停止，不证明全局稳定或动力学稳定。"},
  {"id":"scf","stage":"convergence","title":"建立电子自洽证据","summary":"记录电子迭代、混合、对角化、磁矩和占据的实际收敛行为。","inputs":["calculation protocol","structure"],"outputs":["SCF state","electronic convergence evidence"],"prerequisites":["establish-kpoints","establish-cutoff","establish-smearing"],"convergence_axes":["energy threshold","density threshold","mixing","initial magnetization"],"validation_gates":["termination parsed","residual trend checked","state consistency checked"],"supported_tools":["SCF solver","mixing diagnostics"],"automation_maturity":"assisted","evidence_boundary":"SCF 收敛不证明几何、目标 observable 或真实基态收敛。"},
  {"id":"hpc-resource-pilot","stage":"execution","title":"运行资源 pilot","summary":"用代表性小任务测量内存、并行效率、I/O 和 wall time，再选择资源。","inputs":["validated input","available hardware"],"outputs":["resource model"],"prerequisites":["scf"],"convergence_axes":["MPI ranks","threads","memory","I/O layout"],"validation_gates":["same numerical result checked","pilot representativeness stated"],"supported_tools":["Slurm accounting","timing report"],"automation_maturity":"candidate","evidence_boundary":"更快的 pilot 不代表生产规模、队列等待或总科研周转更优。"},
  {"id":"submit-job","stage":"execution","title":"提交正式运行","summary":"冻结输入身份、代码环境、资源、路径和依赖后提交 scheduler。","inputs":["validated input","resource model"],"outputs":["job ID","run manifest"],"prerequisites":["hpc-resource-pilot"],"convergence_axes":[],"validation_gates":["input hash bound","workdir isolated","dependency explicit"],"supported_tools":["Slurm","PBS","shell manifest"],"automation_maturity":"candidate","evidence_boundary":"队列接受作业只证明调度请求存在，不证明程序已运行或结果有效。"},
  {"id":"monitor-job","stage":"execution","title":"监控运行状态","summary":"区分 scheduler、进程、文件增长、程序阶段和科学进度。","inputs":["job ID","run manifest"],"outputs":["bounded status observations"],"prerequisites":["submit-job"],"convergence_axes":[],"validation_gates":["observer and time recorded","TTL or stale condition set"],"supported_tools":["squeue","sacct","log parser"],"automation_maturity":"candidate","evidence_boundary":"RUNNING、CPU 活跃或日志增长都不能证明正常完成。"},
  {"id":"recover-restart","stage":"execution","title":"恢复、重启与失败分诊","summary":"先识别根因和最后可靠检查点，再在不覆盖证据的路径中恢复。","inputs":["failed run","restart artifacts"],"outputs":["failure diagnosis","new run lineage"],"prerequisites":["monitor-job"],"convergence_axes":[],"validation_gates":["root cause identified","parent-child lineage preserved","numerical continuity checked"],"supported_tools":["scheduler logs","restart files","checkpoint audit"],"automation_maturity":"assisted","evidence_boundary":"从 checkpoint 继续并正常结束不证明前后状态物理等价。"},
  {"id":"parse-output","stage":"property","title":"解析并绑定输出","summary":"验证程序、版本、输入、结束状态和单位后，提取有 lineage 的结构化结果。","inputs":["run outputs","run manifest"],"outputs":["normalized result record"],"prerequisites":["submit-job"],"convergence_axes":[],"validation_gates":["input-output identity matched","units normalized","warnings retained"],"supported_tools":["native parsers","ASE","pymatgen"],"automation_maturity":"candidate","evidence_boundary":"解析成功只证明字段可读，不证明字段在物理上有效。"},
  {"id":"energy-forces","stage":"property","title":"结构、能量与力分支","summary":"比较相对能量、形成能、反应能、力、应力和状态方程时保持参考一致。","inputs":["normalized results","reference states"],"outputs":["energetic artifact"],"prerequisites":["parse-output","relaxation"],"convergence_axes":["reference convergence","cell and composition consistency"],"validation_gates":["same conventions used","metastability separated from stability"],"supported_tools":["equation of state","convex hull","NEB"],"automation_maturity":"assisted","evidence_boundary":"较低静态能不自动证明有限温度稳定、可合成或动力学可达。"},
  {"id":"electronic-structure","stage":"property","title":"电子结构分支","summary":"按一致费米能、路径、投影和占据约定分析能带、DOS 与费米面。","inputs":["parent SCF state","sampling specification"],"outputs":["electronic artifact"],"prerequisites":["parse-output","scf"],"convergence_axes":["dense sampling","projection completeness","broadening"],"validation_gates":["parent state bound","path and energy zero stated","method limitation stated"],"supported_tools":["bands","DOS","Wannier interpolation"],"automation_maturity":"assisted","evidence_boundary":"Kohn-Sham gap、轨道投影或视觉交叉不能直接等同于实验准粒子或拓扑结论。"},
  {"id":"vibrational-response","stage":"property","title":"振动与响应分支","summary":"建立声子、介电、弹性或电子-声子量的父计算、网格和长程修正链。","inputs":["relaxed structure","response protocol"],"outputs":["response artifact"],"prerequisites":["parse-output","relaxation"],"convergence_axes":["q mesh","supercell","displacement","response thresholds"],"validation_gates":["sum rules assessed","imaginary modes retained","interpolation tested"],"supported_tools":["DFPT","finite displacement","Phonopy"],"automation_maturity":"assisted","evidence_boundary":"无虚频的有限采样不证明所有温压条件稳定；虚频也不能未经诊断直接删去。"},
  {"id":"charge-bonding","stage":"property","title":"电荷与成键分支","summary":"在明确分区定义和网格误差下分析密度差、局域量、电荷或键指标。","inputs":["charge density","reference densities"],"outputs":["bonding artifact"],"prerequisites":["parse-output"],"convergence_axes":["FFT grid","partition parameters","reference alignment"],"validation_gates":["charge conservation checked","partition dependence stated"],"supported_tools":["Bader","ELF","density difference"],"automation_maturity":"assisted","evidence_boundary":"分区电荷和可视化等值面是模型依赖描述，不是唯一可观测的化学键。"},
  {"id":"magnetic-topological","stage":"property","title":"磁性与拓扑分支","summary":"比较磁初态、SOC、对称性、带占据和不变量实现，并保留竞争态。","inputs":["electronic states","symmetry data"],"outputs":["magnetic or topological artifact"],"prerequisites":["electronic-structure","enumerate-configurations"],"convergence_axes":["magnetic seeds","k mesh","SOC","Wannier window"],"validation_gates":["competing states compared","symmetry convention recorded","independent diagnostic used"],"supported_tools":["SOC DFT","Wannier90","Wilson loop"],"automation_maturity":"manual","evidence_boundary":"单个磁初态或一次不变量计算不足以建立磁基态或拓扑材料主张。"},
  {"id":"compare-references","stage":"validation","title":"与可信基准比较","summary":"使用适用范围匹配的实验、高级理论或认证基准挑战结果。","inputs":["property artifact","reference evidence"],"outputs":["benchmark comparison"],"prerequisites":["energy-forces"],"convergence_axes":["reference uncertainty"],"validation_gates":["conditions matched","measurement and model uncertainty separated"],"supported_tools":["benchmark table","error metrics"],"automation_maturity":"assisted","evidence_boundary":"与单一实验数值接近可能来自误差抵消，并不验证全部方法链。"},
  {"id":"cross-method","stage":"validation","title":"跨实现或方法复核","summary":"用足够独立的代码、势、基组或理论路线复算关键结论。","inputs":["critical claim","primary workflow"],"outputs":["independent comparison"],"prerequisites":["parse-output"],"convergence_axes":["implementation difference"],"validation_gates":["independence source stated","equivalent observable compared"],"supported_tools":["cross-code calculation","all-electron benchmark"],"automation_maturity":"manual","evidence_boundary":"共享同一近似、结构或错误的数据链会限制所谓独立性。"},
  {"id":"uncertainty-sensitivity","stage":"validation","title":"敏感性与不确定性分析","summary":"量化关键参数、模型选择和拟合对结论方向与幅度的影响。","inputs":["property artifact","assumption list"],"outputs":["sensitivity matrix"],"prerequisites":["parse-output","acceptance-criteria"],"convergence_axes":["model parameters","numerical thresholds","fit windows"],"validation_gates":["decision robustness tested","dominant uncertainties ranked"],"supported_tools":["parameter sweep","bootstrap","error propagation"],"automation_maturity":"candidate","evidence_boundary":"扫描有限参数范围不能覆盖未知模型缺陷或系统误差。"},
  {"id":"physical-sanity","stage":"validation","title":"执行物理 sanity checks","summary":"检查守恒律、对称性、极限行为、量纲、符号和已知趋势。","inputs":["normalized results","physical model"],"outputs":["sanity-check ledger"],"prerequisites":["parse-output"],"convergence_axes":[],"validation_gates":["failed checks remain visible","exceptions explained"],"supported_tools":["sum rules","symmetry checks","dimensional analysis"],"automation_maturity":"candidate","evidence_boundary":"通过必要条件不等于结论充分成立；sanity check 不能替代收敛与独立验证。"},
  {"id":"provenance-package","stage":"provenance","title":"构建可重现证据包","summary":"用 manifest 和 hash 连接输入、环境、运行、raw/derived artifact 与验证记录。","inputs":["run manifests","result records","validation matrix"],"outputs":["reproducibility package"],"prerequisites":["parse-output","uncertainty-sensitivity"],"convergence_axes":[],"validation_gates":["lineage complete","restricted materials excluded","replay instructions tested"],"supported_tools":["Git","checksums","RO-Crate-style manifest"],"automation_maturity":"candidate","evidence_boundary":"文件齐全和 hash 一致证明身份与可追溯性，不证明计算或科学结论正确。"},
  {"id":"claim-ledger","stage":"provenance","title":"维护主张与证据账本","summary":"逐条连接来源记录、解释、推断、未知和论文级主张，保留反证与边界。","inputs":["reproducibility package","validation matrix"],"outputs":["claim ledger","handoff"],"prerequisites":["provenance-package","physical-sanity","cross-method"],"convergence_axes":[],"validation_gates":["claim strength matches evidence","unknowns explicit","owner decision retained"],"supported_tools":["evidence table","handoff template"],"automation_maturity":"manual","evidence_boundary":"完整记录支持审查，但最终科学接受和论文主张仍需研究者判断。"}
]
