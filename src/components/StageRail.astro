---
import stagesData from '../data/stages.json';
import type { Stage } from '../types';
import { withBase } from '../lib/paths';

const stages = stagesData as Stage[];
const { compact = false } = Astro.props;
---

<ol class:list={['stage-rail', { compact }]} aria-label="DFT 研究的八个阶段">
  {stages.map((stage, index) => (
    <li>
      <a href={withBase(`stages/${stage.id}/`)}>
        <span class="rail-number">{stage.number}</span>
        <span class="rail-copy"><b>{stage.title}</b><small>{stage.eyebrow}</small></span>
      </a>
      {index < stages.length - 1 && <span class="rail-line" aria-hidden="true"></span>}
    </li>
  ))}
</ol>
