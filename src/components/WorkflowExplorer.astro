---
import operationsData from '../data/operations.json';
import stagesData from '../data/stages.json';
import type { Operation, Stage } from '../types';

const operations = operationsData as Operation[];
const stages = stagesData as Stage[];
const maturityLabel = { manual: '研究者判断', assisted: '可辅助', candidate: '候选自动化' };
---

<section class="workflow-explorer" data-workflow-explorer>
  <div class="explorer-toolbar" aria-label="筛选 operation">
    <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">全部 · {operations.length}</button>
    <button class="filter-button" type="button" data-filter="manual" aria-pressed="false">研究者判断</button>
    <button class="filter-button" type="button" data-filter="assisted" aria-pressed="false">可辅助</button>
    <button class="filter-button" type="button" data-filter="candidate" aria-pressed="false">候选自动化</button>
  </div>
  <p class="filter-readout" aria-live="polite" data-filter-readout>显示全部 {operations.length} 项 operation。</p>

  <div class="operation-stages">
    {stages.map((stage) => {
      const stageOperations = operations.filter((operation) => operation.stage === stage.id);
      return (
        <section class="operation-stage" data-stage-section>
          <header>
            <span>{stage.number}</span>
            <div><h2>{stage.title}</h2><p>{stage.eyebrow}</p></div>
            <strong data-stage-count>{stageOperations.length}</strong>
          </header>
          <div class="operation-grid">
            {stageOperations.map((operation) => (
              <article class="operation-card" data-operation data-maturity={operation.automation_maturity}>
                <div class="operation-topline">
                  <code>{operation.id}</code>
                  <span class={`maturity maturity-${operation.automation_maturity}`}>{maturityLabel[operation.automation_maturity]}</span>
                </div>
                <h3>{operation.title}</h3>
                <p>{operation.summary}</p>
                <details>
                  <summary>查看契约</summary>
                  <dl>
                    <div><dt>输入</dt><dd>{operation.inputs.join(' · ')}</dd></div>
                    <div><dt>输出</dt><dd>{operation.outputs.join(' · ')}</dd></div>
                    <div><dt>验证门</dt><dd>{operation.validation_gates.join(' · ')}</dd></div>
                  </dl>
                  <p class="evidence-note"><b>边界</b>{operation.evidence_boundary}</p>
                </details>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</section>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-workflow-explorer]');
  if (explorer) {
    const buttons = [...explorer.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...explorer.querySelectorAll<HTMLElement>('[data-operation]')];
    const readout = explorer.querySelector<HTMLElement>('[data-filter-readout]');
    const applyFilter = (filter: string, label: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.maturity === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });
      explorer.querySelectorAll<HTMLElement>('[data-stage-section]').forEach((section) => {
        const sectionCards = [...section.querySelectorAll<HTMLElement>('[data-operation]')];
        const sectionVisible = sectionCards.filter((card) => !card.hidden).length;
        section.hidden = sectionVisible === 0;
        const count = section.querySelector<HTMLElement>('[data-stage-count]');
        if (count) count.textContent = String(sectionVisible);
      });
      if (readout) readout.textContent = `显示 ${label} ${visible} 项 operation。`;
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        applyFilter(button.dataset.filter ?? 'all', button.textContent?.split(' · ')[0] ?? '全部');
      });
    });
  }
</script>
