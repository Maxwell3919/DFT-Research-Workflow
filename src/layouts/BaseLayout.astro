---
import '../styles/global.css';
import '../styles/practical.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'operations' | 'recipes' | 'framework';
}

const { title, description, current } = Astro.props;
const pageTitle = title === 'DFT Research Workflow' ? title : `${title} · DFT Research Workflow`;
const navigation = [
  { id: 'home', label: 'Home', href: withBase() },
  { id: 'operations', label: 'Operations', href: withBase('operations/') },
  { id: 'recipes', label: 'Workflow Recipes', href: withBase('recipes/') },
  { id: 'framework', label: 'Framework', href: withBase('framework/') },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href={withBase()}>DFT Research Workflow</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>A software-neutral guide to researcher-scale DFT tasks and scientific workflows.</p>
    </footer>
  </body>
</html>
