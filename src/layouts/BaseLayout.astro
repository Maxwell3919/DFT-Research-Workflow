---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/practical.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'operations' | 'workflows' | 'tools';
  redirectTo?: string;
  wide?: boolean;
}

const { title, description, current, redirectTo, wide = false } = Astro.props;
const pageTitle = title === 'DFT Research Workflow' ? title : `${title} · DFT Research Workflow`;
const navigation = [
  { id: 'home', label: 'Home', href: withBase() },
  { id: 'operations', label: 'Research Workflow', href: withBase('operations/') },
  { id: 'workflows', label: 'Worked Workflows', href: withBase('workflows/') },
  { id: 'tools', label: 'Tools & Resources', href: withBase('tools/') },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    {redirectTo && <link rel="canonical" href={redirectTo} />}
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <style is:inline>
      :root, html, body {
        background: #ffffff;
        color: #1a1a1a;
      }
      body {
        font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, "Times New Roman", serif;
      }
    </style>
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'wide-shell': wide }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href={withBase()}>DFT Research Workflow</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>A software-neutral guide to researcher-scale DFT tasks and scientific workflows.</p>
    </footer>
    <script is:inline data-copy-enhancement>
      (() => {
        const copyableSelector = [
          'pre[data-copyable] > code',
          'pre[data-language="bash"] > code',
          'pre[data-language="shell"] > code',
          'pre[data-language="sh"] > code',
          'pre[data-language="python"] > code',
          'pre[data-language="qe"] > code',
          'pre[data-language="slurm"] > code',
          'pre[data-language="json"] > code',
          'pre[data-language="plaintext"] > code',
          'pre[data-language="gnuplot"] > code',
          'pre > code.language-bash',
          'pre > code.language-shell',
          'pre > code.language-sh',
          'pre > code.language-python',
          'pre > code.language-qe',
          'pre > code.language-slurm',
          'pre > code.language-json',
          'pre > code.language-plaintext',
          'pre > code.language-gnuplot',
        ].join(',');

        for (const code of document.querySelectorAll(copyableSelector)) {
          const pre = code.parentElement;
          if (!pre || pre.dataset.copyReady === 'true') continue;
          pre.dataset.copyReady = 'true';

          const wrapper = document.createElement('div');
          wrapper.className = 'copyable-code';
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-code-button';
          button.textContent = 'Copy';
          button.setAttribute('aria-label', 'Copy code to clipboard');

          const status = document.createElement('span');
          status.className = 'copy-code-status';
          status.setAttribute('role', 'status');
          status.setAttribute('aria-live', 'polite');

          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code.textContent ?? '');
              button.textContent = 'Copied';
              status.textContent = 'Code copied to clipboard.';
            } catch {
              button.textContent = 'Copy failed';
              status.textContent = 'Copy failed. Select the code and copy it manually.';
            }
            window.setTimeout(() => {
              button.textContent = 'Copy';
              status.textContent = '';
            }, 1800);
          });

          wrapper.prepend(button, status);
        }
      })();
    </script>
  </body>
</html>
