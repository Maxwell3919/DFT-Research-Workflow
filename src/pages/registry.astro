---
import BaseLayout from '../layouts/BaseLayout.astro';
import operationsData from '../data/operations.json';
import stagesData from '../data/stages.json';
import type { Operation, Stage } from '../types';
import { withBase } from '../lib/paths';

const operations = operationsData as Operation[];
const stages = stagesData as Stage[];
const stageById = new Map(stages.map((stage) => [stage.id, stage]));
---

<BaseLayout title="Operation registry" description="DFT Research Workflow 的机器可读 operation 元数据。" current="registry">
  <header class="page-hero shell registry-hero">
    <p class="kicker"><span>MACHINE-READABLE MAP</span> / schema-validated</p>
    <h1>三十五项 operation，<br /><em>一份结构权威。</em></h1>
    <p>页面从同一份 JSON registry 生成。它记录输入、输出、前置条件、收敛轴、验证门、工具族和自动化成熟度，但不充当生产计算协议。</p>
    <a class="button ghost" href={withBase('data/operations.json')}>读取原始 JSON →</a>
  </header>
  <section class="shell registry-table-wrap">
    <table class="registry-table">
      <thead><tr><th>Operation</th><th>Stage</th><th>Maturity</th><th>Outputs</th><th>Evidence boundary</th></tr></thead>
      <tbody>{operations.map((operation) => <tr><td><code>{operation.id}</code><b>{operation.title}</b></td><td>{stageById.get(operation.stage)?.number} · {stageById.get(operation.stage)?.title}</td><td><span class={`maturity maturity-${operation.automation_maturity}`}>{operation.automation_maturity}</span></td><td>{operation.outputs.join(' · ')}</td><td>{operation.evidence_boundary}</td></tr>)}</tbody>
    </table>
  </section>
</BaseLayout>
