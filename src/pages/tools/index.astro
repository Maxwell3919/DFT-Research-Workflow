---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import {
  getResourceTaskGroups,
  getResources,
  getResourcesForTopic,
  toolRegistryMetadata,
} from '../../lib/tools';
import { getWorkflowTopics } from '../../lib/workflow';
import landscapeCompatibility from '../../../workflow/resource-landscape.json';

interface Props {
  compatibilityRoute?: boolean;
}

const { compatibilityRoute = false } = Astro.props;
const resources = getResources();
const taskGroups = getResourceTaskGroups();
const workflowTopics = getWorkflowTopics();
const detailedCount = resources.filter((resource) => resource.detail).length;
const reviewedAt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${toolRegistryMetadata.verifiedAt}T00:00:00Z`));
const accessLabels = {
  open: 'Open',
  registration: 'Registration',
  institutional: 'Institutional',
  subscription: 'Subscription',
  commercial: 'Commercial',
  mixed: 'Mixed access',
  restricted: 'Restricted licence',
  'free-proprietary': 'Free proprietary',
} as const;
const aliasesByGroup = new Map<string, string[]>();
for (const [alias, target] of Object.entries(landscapeCompatibility.anchor_aliases)) {
  aliasesByGroup.set(target, [...(aliasesByGroup.get(target) ?? []), alias]);
}
const primaryResources = (groupId: string) => resources.filter((resource) => resource.task_groups[0] === groupId);
const topicResources = new Map(workflowTopics.map((topic) => [topic.slug, getResourcesForTopic(topic.slug)]));
const topicBySlug = new Map(workflowTopics.map((topic) => [topic.slug, topic]));
const compactTopicLabels: Record<string, string> = {
  'obtain-material-structure': 'Find structure',
  'build-or-modify-computational-model': 'Build model',
  'choose-dft-method-and-computational-setup': 'Method setup',
  'test-numerical-convergence': 'Convergence',
  'optimize-structure': 'Relax',
  'calculate-reference-ground-state': 'SCF',
  'relative-and-formation-energies': 'Energies',
  'equation-of-state-and-structural-phase-stability': 'EOS',
  'compositional-phase-stability-and-convex-hulls': 'Convex hulls',
  'defect-formation-energies-and-charge-states': 'Defects',
  'surface-energy-and-work-function': 'Surfaces',
  'adsorption-energies': 'Adsorption',
  'interface-and-heterostructure-energetics': 'Interfaces',
  'band-structure': 'Bands',
  'density-of-states-and-projected-density-of-states': 'DOS / PDOS',
  'fermi-surface-and-full-brillouin-zone-analysis': 'Full BZ / Fermi surface',
  'charge-density-and-charge-redistribution': 'Charge density',
  'electrostatic-potential-and-band-alignment': 'Potential / alignment',
  'chemical-bonding-analysis': 'Bonding',
  'magnetic-configuration-and-ground-state-comparison': 'Magnetic state',
  'magnetic-anisotropy-and-exchange-interactions': 'Magnetic interactions',
  'elastic-constants-and-mechanical-properties': 'Elasticity',
  'dielectric-response-and-born-effective-charges': 'Dielectric',
  'polarization-and-ferroelectricity': 'Polarization',
  'piezoelectric-response': 'Piezoelectric',
  'harmonic-phonons': 'Phonons',
  'anharmonic-phonons': 'Anharmonic phonons',
  'lattice-thermal-transport': 'Thermal transport',
  'electron-phonon-coupling': 'EPC',
  'conventional-superconductivity': 'Superconductivity',
  'reaction-paths-and-transition-states': 'Reaction paths',
  'diffusion-barriers': 'Diffusion',
  'ab-initio-molecular-dynamics': 'AIMD',
  'finite-temperature-structural-sampling': 'Finite-temperature sampling',
  'independent-particle-optical-properties': 'Optics',
  'time-dependent-response-and-spectroscopy': 'Spectroscopy',
  'quasiparticle-corrections': 'Quasiparticles',
  'excitons-and-bethe-salpeter-equation': 'BSE / excitons',
  'wannier-function-construction': 'Wannier',
  'berry-phase-and-berry-curvature': 'Berry phase / curvature',
  'topological-invariants-and-boundary-states': 'Topology',
  'electronic-transport': 'Electronic transport',
  'quantum-transport': 'Quantum transport',
  'analyze-and-compare-results': 'Analyze',
  'validate-results-and-scientific-conclusions': 'Validate',
  'document-and-preserve-study': 'Preserve',
};
const compactTopicLabel = (slug: string) => compactTopicLabels[slug] ?? topicBySlug.get(slug)?.title ?? slug;
const visibleTopicLimit = 4;
---

<BaseLayout
  title="Tools & Resources"
  description="A task-organized catalog of databases, viewers, codes, libraries, workflows, archives, manuals, tutorials, and communities used around the DFT research workflow."
  current="tools"
>
  <article class="resource-directory" data-tools-resources>
    <header class="directory-intro">
      {compatibilityRoute && (
        <p class="scope-note" data-resource-landscape-compatibility>
          This legacy route uses the same registry and renderer. The canonical directory is
          {' '}<a href={withBase('tools/')}>Tools & Resources</a>.
        </p>
      )}
      <p class="operation-label">Secondary research index</p>
      <h1>Tools & Resources</h1>
      <p class="page-intro">
        Browse by research task, or use <kbd>Ctrl</kbd>/<kbd>Cmd</kbd> + <kbd>F</kbd>. Web, GUI, CLI, API,
        Python, and HPC describe access; they do not rank the resources.
      </p>
      <p>
        <strong>{resources.length}</strong> resources are listed; <strong>{detailedCount}</strong>{' '}
        have deeper DRW pages. Entries are alphabetical within each task, not ranked.
      </p>
      <p class="scope-note">
        Official entry points were reviewed on
        {' '}<time datetime={toolRegistryMetadata.verifiedAt}>{reviewedAt}</time>. Check the current version,
        access conditions, and compatibility before use; inclusion is not an endorsement or evidence that a result is valid.
      </p>
    </header>

    <nav class="task-index" aria-label="Tools and resources by research task">
      <p>Browse by research task:</p>
      <ol>
        {taskGroups.map((group) => (
          <li><a href={`#${group.id}`}>{group.title}</a> <span>{primaryResources(group.id).length}</span></li>
        ))}
      </ol>
    </nav>

    <details class="workflow-topic-index" data-topic-resource-index>
      <summary>Browse the resource links for all {workflowTopics.length} A–E workflow topics</summary>
      <ol>
        {workflowTopics.map((topic) => {
          const related = topicResources.get(topic.slug) ?? [];
          return (
            <li data-topic-resource={topic.slug}>
              <p>
                <a href={withBase(`operations/${topic.slug}/`)}>{topic.title}</a>
                <span>{related.length} resources</span>
              </p>
              <ul>
                {related.map((resource) => (
                  <li>
                    <a href={`#resource-${resource.slug}`}>
                      <span
                        data-resource-title-reference={resource.slug}
                        lang={resource.language}
                      >{resource.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ol>
    </details>

    {taskGroups.map((group) => {
      const entries = primaryResources(group.id);
      return (
        <section id={group.id} class="resource-task" data-resource-task={group.id} aria-labelledby={`${group.id}-title`}>
          {(aliasesByGroup.get(group.id) ?? []).map((alias) => <span class="anchor-alias" id={alias} aria-hidden="true"></span>)}
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p>{group.intro}</p>
          <div class="resource-table-wrap">
            <table class="resource-table">
              <caption>{group.title}: official entries and connections to the research workflow</caption>
              <colgroup>
                <col class="resource-column" />
                <col class="purpose-column" />
                <col class="access-column" />
                <col class="used-in-column" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col">Resource</th>
                  <th scope="col">Best used for</th>
                  <th scope="col">Access</th>
                  <th scope="col">Used in</th>
                </tr>
              </thead>
              <tbody>
                {entries.map((resource) => {
                  const usedInTopics = resource.topics.map((slug) => {
                    const topic = topicBySlug.get(slug);
                    if (!topic) throw new Error(`${resource.slug}: unresolved topic ${slug}`);
                    return topic;
                  });
                  const visibleTopics = usedInTopics.slice(0, visibleTopicLimit);
                  const remainingTopics = usedInTopics.slice(visibleTopicLimit);
                  return (
                    <tr id={`resource-${resource.slug}`} data-resource={resource.slug}>
                      <th scope="row" class="resource-name-cell">
                        <h3>
                          {resource.detail ? (
                            <a data-resource-detail-link href={withBase(`tools/${resource.slug}/`)}>
                              <span data-resource-title={resource.slug} lang={resource.language}>{resource.name}</span>
                            </a>
                          ) : (
                            <span data-resource-title={resource.slug} lang={resource.language}>{resource.name}</span>
                          )}
                        </h3>
                        <p class="resource-kind">{resource.kind_tags.join(' · ')}</p>
                        <p class="resource-entry-links">
                          {resource.links.map((link, index) => (
                            <>
                              {index > 0 && <span aria-hidden="true"> · </span>}
                              <a data-resource-link href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
                            </>
                          ))}
                        </p>
                        {resource.caveat && (
                          <details class="resource-caveat">
                            <summary>Access note</summary>
                            <p>{resource.caveat}</p>
                          </details>
                        )}
                      </th>
                      <td data-label="Best used for" class="resource-purpose">{resource.one_line}</td>
                      <td data-label="Access" class="resource-access">
                        <span>{resource.interface_tags.join(' · ')}</span>
                        <span>{accessLabels[resource.access]}</span>
                      </td>
                      <td data-label="Used in" class="resource-used-in">
                        <ul>
                          {visibleTopics.map((topic) => (
                            <li><a href={withBase(`operations/${topic.slug}/`)}>{compactTopicLabel(topic.slug)}</a></li>
                          ))}
                        </ul>
                        {remainingTopics.length > 0 && (
                          <details>
                            <summary>+{remainingTopics.length} more</summary>
                            <ul>
                              {remainingTopics.map((topic) => (
                                <li><a href={withBase(`operations/${topic.slug}/`)}>{compactTopicLabel(topic.slug)}</a></li>
                              ))}
                            </ul>
                          </details>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}
  </article>
</BaseLayout>
