---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTools, toolRegistryMetadata } from '../../lib/tools';
import { withBase } from '../../lib/paths';

const tools = getTools();
const categories = [...new Set(tools.map((tool) => tool.category))];
const verifiedAt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${toolRegistryMetadata.verifiedAt}T00:00:00Z`));
---
<BaseLayout title="Tools" description="A human-first secondary index of tools connected to the scientific workflow." current="tools">
  <h1>Tools</h1>
  <p class="page-intro">
    Start with the research task, then choose the browser, GUI, terminal program, library, or provenance tool that fits it.
    The order follows a common human research sequence; it is not a ranking.
  </p>
  <p>
    These 17 entries provide reviewed depth. For broader discovery across open, registered, institutional,
    subscription, and commercial resources, <a data-resource-landscape-link href={withBase('operations/resource-landscape/')}>browse the Resource Landscape</a>.
  </p>
  <p>
    Identities and entry points were reviewed on {verifiedAt}. Match capability, input semantics, access terms,
    and version compatibility to the calculation you actually perform.
  </p>

  {categories.map((category) => (
    <section class="tool-category">
      <h2>{category}</h2>
      <ul class="directory-list">
        {tools.filter((tool) => tool.category === category).map((tool) => (
          <li>
            <a href={withBase(`tools/${tool.slug}/`)}>{tool.name}</a>
            <span>{tool.role}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
