---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContextualLinks from '../../components/ContextualLinks.astro';
import { getContextualNavigation } from '../../lib/contextual-navigation';
import {
  getDetailedResources,
  getResource,
  getResourceTaskGroups,
  getResourceTopics,
  toolRegistryMetadata,
} from '../../lib/tools';
import { withBase } from '../../lib/paths';

export const getStaticPaths = () => getDetailedResources().map((resource) => ({ params: { slug: resource.slug } }));

const resource = getResource(Astro.params.slug!);
if (!resource.detail) throw new Error(`${resource.slug}: catalog-only resource has no depth route`);
const topics = getResourceTopics(resource);
const taskGroups = getResourceTaskGroups();
const primaryGroup = taskGroups.find((group) => group.id === resource.task_groups[0]);
if (!primaryGroup) throw new Error(`${resource.slug}: primary resource task is unresolved`);
const guides = (await getCollection('practicalGuides'))
  .filter((guide) => guide.data.status === 'reviewed' && guide.data.tools.includes(resource.slug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const accessLabels = {
  open: 'Open',
  registration: 'Registration required',
  institutional: 'Institutional access',
  subscription: 'Subscription',
  commercial: 'Commercial',
  mixed: 'Mixed access',
  restricted: 'Restricted licence',
  'free-proprietary': 'Free proprietary licence',
} as const;
const reviewedAtLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${toolRegistryMetadata.verifiedAt}T00:00:00Z`));
const contextualNavigation = getContextualNavigation({ kind: 'tool', slug: resource.slug });
const verificationNote = resource.caveat
  ?? 'Check current official documentation, access terms, release compatibility, input semantics, and the evidence needed for the specific research claim.';
---

<BaseLayout
  title={resource.name}
  description={`${resource.name}: official entry points and connections to the DFT research workflow.`}
  current="tools"
>
  <article class="tool-detail" data-resource-detail={resource.slug}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('tools/')}>Tools & Resources</a> / {resource.name}</nav>
    <p class="operation-label">{primaryGroup.title}</p>
    <h1>{resource.name}</h1>
    {resource.aliases.length > 0 && <p class="tool-aliases">Also known as {resource.aliases.join(', ')}.</p>}
    <p class="page-intro">{resource.one_line}</p>

    <dl class="tool-facts">
      <div><dt>Access</dt><dd>{accessLabels[resource.access]}</dd></div>
      <div><dt>Interfaces</dt><dd>{resource.interface_tags.join(', ')}</dd></div>
      <div><dt>Tags</dt><dd>{resource.kind_tags.join(', ')}</dd></div>
      <div><dt>Entry points reviewed</dt><dd><time datetime={toolRegistryMetadata.verifiedAt}>{reviewedAtLabel}</time></dd></div>
    </dl>

    <h2>Official entry points</h2>
    <ul class="directory-list">
      {resource.links.map((link) => <li><a data-resource-link href={link.url}>{link.label}</a><span>{link.role}</span></li>)}
    </ul>

    <h2>Where in the research workflow</h2>
    <ul class="directory-list" data-resource-topics>
      {topics.map((topic) => <li><a href={withBase(`operations/${topic.slug}/`)}>{topic.title}</a></li>)}
    </ul>

    <h2>Reviewed practical pages</h2>
    {guides.length > 0 ? (
      <ul class="directory-list">
        {guides.map((guide) => {
          const segment = guide.data.kind === 'worked-example' ? 'examples' : guide.data.kind === 'visual-note' ? 'notes' : 'guides';
          return <li><a href={withBase(`operations/${guide.data.topic_slug}/${segment}/${guide.data.guide_slug}/`)}>{guide.data.title}</a><span>{guide.data.summary}</span></li>;
        })}
      </ul>
    ) : (
      <p>No reviewed hands-on page currently demonstrates this resource. Start from the connected research task and the official entry point.</p>
    )}

    <h2>What to verify</h2>
    <p data-tool-verify>{verificationNote}</p>
    <p class="framework-note">A resource identity, reachable link, successful program run, or plausible figure does not by itself establish numerical convergence, scientific validity, or suitability for a material.</p>

    {contextualNavigation && <ContextualLinks navigation={contextualNavigation} />}
  </article>
</BaseLayout>

<style>
  .tool-detail { max-width: 58rem; margin: 0 auto; padding-bottom: 4rem; }
  .tool-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: 1.5rem 0 2.5rem; border-block: 1px solid var(--rule); }
  .tool-facts > div { padding: 0.7rem 0; }
  .tool-facts > div:nth-child(odd) { padding-right: 1.25rem; }
  .tool-facts dt { font-weight: 700; }
  .tool-facts dd { margin: 0.2rem 0 0; color: var(--muted); overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .tool-facts { grid-template-columns: 1fr; }
    .tool-facts > div:nth-child(odd) { padding-right: 0; }
  }
</style>
