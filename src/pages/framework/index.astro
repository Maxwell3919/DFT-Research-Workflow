---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const destinations = [
  {
    title: 'Research Workflow map, branching, and feedback',
    href: 'operations/',
    detail: 'The A–E directory introduces the workflow as a branching, revisitable research map rather than a fixed sequence.',
  },
  {
    title: 'Method context',
    href: 'operations/choose-dft-method-and-computational-setup/',
    detail: 'Method choice, implementation compatibility, and setup identity now belong with calculation preparation.',
  },
  {
    title: 'Evidence boundaries',
    href: 'operations/validate-results-and-scientific-conclusions/',
    detail: 'Validation distinguishes artifact checks, numerical convergence, physical consistency, and claim support.',
  },
  {
    title: 'Provenance and reproducibility',
    href: 'operations/document-and-preserve-study/',
    detail: 'Study identity, lineage, preservation, and reconstruction now belong with research completion.',
  },
];
---

<BaseLayout title="Framework migration" description="Migrated cross-cutting concepts in the A–E research workflow.">
  <h1>Framework migration</h1>
  <p class="page-intro">
    Framework is no longer a primary section. Its useful cross-cutting material has been placed with the researcher-scale task where it is used. This temporary page preserves older links without creating another public taxonomy.
  </p>
  <ol class="directory-list">
    {destinations.map((destination) => (
      <li>
        <a href={withBase(destination.href)}>{destination.title}</a>
        <span>{destination.detail}</span>
      </li>
    ))}
  </ol>
</BaseLayout>
