---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workflowSections } from '../../lib/workflow';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Research Workflow"
  description="The A–E DFT research workflow, from structures to target calculations and research completion."
  current="operations"
>
  <h1>Research Workflow</h1>
  <p class="page-intro">
    The workflow is organized around tasks that researchers plan and discuss as meaningful units of work. A–C establish the structure, setup, and reference state; D branches into the calculations required by the scientific question; E turns the results into a supported and reproducible conclusion.
  </p>

  {workflowSections.map((section) => (
    <section class="part-section" id={`part-${section.id.toLowerCase()}`} aria-labelledby={`part-${section.id.toLowerCase()}-heading`}>
      <header>
        <h2 id={`part-${section.id.toLowerCase()}-heading`}>{section.id} · {section.title}</h2>
        <p>{section.summary}</p>
      </header>

      {section.groups.map((group) => (
        <div class="workflow-group">
          {section.id === 'D' && <h3>{group.id} · {group.title}</h3>}
          {section.id === 'D' && <p class="group-summary">{group.summary}</p>}
          <ul class="directory-list topic-list">
            {group.topics.map((topic) => (
              <li><a href={withBase(`operations/${topic.slug}/`)}>{topic.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}

  <p class="framework-note">
    Older direct links remain temporarily available while their useful content is migrated. They are not part of the current reading structure.
  </p>
</BaseLayout>
