---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workflowSections } from '../../lib/workflow';
import { withBase } from '../../lib/paths';
import researchQuestionNavigator from '../../../workflow/research-question-navigator.json';

type RelatedTopic = {
  topic_slug: string;
  context: string;
};

type GuideAction = {
  type: 'guide';
  guide_slug: string;
  guide_kind: 'implementation' | 'worked-example' | 'visual-note';
  evidence_boundary: string;
};

type NoGuideAction = {
  type: 'no-guide';
  statement: string;
};

type ResearchQuestion = {
  id: string;
  question: string;
  required_observable: string;
  topic_slug: string;
  related_topics?: RelatedTopic[];
  prerequisites: string;
  common_human_route: string;
  what_to_inspect: string;
  first_action: GuideAction | NoGuideAction;
  validation_requirement: string;
  claim_limitation: string;
};

type NavigatorDefinition = {
  schema_version: number;
  role: string;
  public_heading: string;
  intro: string;
  boundary: string;
  questions: ResearchQuestion[];
};

type ResolvedGuideAction = GuideAction & {
  title: string;
  href: string;
};

type ResolvedQuestion = Omit<ResearchQuestion, 'first_action' | 'related_topics'> & {
  topic: { slug: string; title: string };
  relatedTopics: Array<RelatedTopic & { title: string; href: string }>;
  firstAction: ResolvedGuideAction | NoGuideAction;
};

const navigatorDefinition = researchQuestionNavigator as NavigatorDefinition;
const topicBySlug = new Map(
  workflowSections.flatMap((section) =>
    section.groups.flatMap((group) => group.topics.map((topic) => [topic.slug, topic] as const)),
  ),
);
const practicalGuides = await getCollection('practicalGuides', ({ data }) => data.status === 'reviewed');
const guideBySlug = new Map<string, CollectionEntry<'practicalGuides'>>();

for (const guide of practicalGuides) {
  if (guideBySlug.has(guide.data.guide_slug)) {
    throw new Error(`Research Question Navigator: duplicate guide_slug ${guide.data.guide_slug}`);
  }
  guideBySlug.set(guide.data.guide_slug, guide);
}

if (navigatorDefinition.role !== 'editorial-question-to-existing-route-bridge') {
  throw new Error('Research Question Navigator: definition must remain an editorial bridge to the A-E registry');
}
if (navigatorDefinition.questions.length !== 10) {
  throw new Error(`Research Question Navigator: expected 10 bounded questions, found ${navigatorDefinition.questions.length}`);
}

const resolvedQuestions: ResolvedQuestion[] = navigatorDefinition.questions.map((question) => {
  const topic = topicBySlug.get(question.topic_slug);
  if (!topic) throw new Error(`Research Question Navigator: unresolved topic_slug ${question.topic_slug}`);

  const relatedTopics = (question.related_topics ?? []).map((related) => {
    const relatedTopic = topicBySlug.get(related.topic_slug);
    if (!relatedTopic) throw new Error(`Research Question Navigator: unresolved related topic_slug ${related.topic_slug}`);
    return {
      ...related,
      title: relatedTopic.title,
      href: withBase(`operations/${relatedTopic.slug}/`),
    };
  });

  let firstAction: ResolvedGuideAction | NoGuideAction;
  if (question.first_action.type === 'guide') {
    const guide = guideBySlug.get(question.first_action.guide_slug);
    if (!guide) throw new Error(`Research Question Navigator: unresolved guide_slug ${question.first_action.guide_slug}`);
    if (guide.data.topic_slug !== question.topic_slug) {
      throw new Error(`Research Question Navigator: ${guide.data.guide_slug} belongs to ${guide.data.topic_slug}, not ${question.topic_slug}`);
    }
    if (guide.data.kind !== question.first_action.guide_kind) {
      throw new Error(`Research Question Navigator: ${guide.data.guide_slug} kind is ${guide.data.kind}, not ${question.first_action.guide_kind}`);
    }
    const category = guide.data.kind === 'worked-example' ? 'examples' : 'guides';
    firstAction = {
      ...question.first_action,
      title: guide.data.title,
      href: withBase(`operations/${question.topic_slug}/${category}/${guide.data.guide_slug}/`),
    };
  } else {
    if (practicalGuides.some((guide) => guide.data.topic_slug === question.topic_slug)) {
      throw new Error(`Research Question Navigator: ${question.topic_slug} declares no guide despite a reviewed guide being available`);
    }
    firstAction = question.first_action;
  }

  return {
    ...question,
    topic,
    relatedTopics,
    firstAction,
  };
});
---

<BaseLayout
  title="Research Workflow"
  description="A question-led A–E DFT manual: define the required observable, select a bounded target calculation, and follow evidence back when necessary."
  current="operations"
>
  <article class="workflow-manual">
    <header class="workflow-lede">
      <h1>Choose the calculation your question requires</h1>
      <p class="page-intro">
        Find the observable your question needs, then open the calculation that produces it. Use A–C when you still need a structure, model, numerical setup, relaxed geometry, or reference state; use E when you need to judge or preserve the result.
      </p>
    </header>

    <section class="observable-selection question-navigator" data-research-question-navigator aria-labelledby="question-navigator-heading">
      <header>
        <h2 id="question-navigator-heading">{navigatorDefinition.public_heading}</h2>
        <p>{navigatorDefinition.intro}</p>
      </header>

      <div class="question-table-wrap">
        <table class="question-table">
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col">Observable or evidence</th>
              <th scope="col">Start here</th>
            </tr>
          </thead>
          <tbody>
            {resolvedQuestions.map((question) => (
              <tr data-research-question={question.id}>
                <th scope="row">{question.question}</th>
                <td>{question.required_observable}</td>
                <td><a data-primary-topic href={withBase(`operations/${question.topic.slug}/`)}>{question.topic.title}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="navigator-boundary">These routes identify the calculation to start. The linked page explains the objects, checks, failure branches, and what the result can support.</p>
    </section>

    <p class="workflow-support-links" data-workflow-support-links>
      If a calculation fails or you need to translate the same scientific task into another code, start with
      the copy-ready <a href={withBase('quick-reference/')}>Quick Reference</a>,
      {' '}<a href={withBase('operations/troubleshooting/')}>Troubleshooting</a>, the
      {' '}<a href={withBase('operations/software-bridge/')}>Software Bridge</a>, or the
      {' '}<a href={withBase('tools/')}>Tools & Resources catalog</a>.
    </p>

    <section class="topic-directory" aria-labelledby="directory-heading">
      <header class="directory-heading">
        <h2 id="directory-heading">Choose the next task</h2>
        <p>Open the task that produces or checks the object you need. D is grouped by target quantity; this directory is not a required linear sequence.</p>
      </header>

      {workflowSections.map((section) => (
        <section class="part-section" id={`part-${section.id.toLowerCase()}`} aria-labelledby={`part-${section.id.toLowerCase()}-heading`}>
          <header>
            <h2 id={`part-${section.id.toLowerCase()}-heading`}>{section.id} · {section.title}</h2>
            <p>{section.summary}</p>
          </header>

          {section.groups.map((group) => (
            <div class="workflow-group">
              {section.id === 'D' && <h3>{group.id} · {group.title}</h3>}
              {section.id === 'D' && <p class="group-summary">{group.summary}</p>}
              <ul class="directory-list topic-list">
                {group.topics.map((topic) => (
                  <li><a href={withBase(`operations/${topic.slug}/`)}>{topic.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </section>
  </article>
</BaseLayout>

<style>
  .workflow-manual {
    --ink: #181714;
    --muted: #666158;
    --rule: #d9d4ca;
    --accent: #8a3f28;
    color: var(--ink);
    max-width: 76rem;
  }

  .workflow-lede {
    max-width: 58rem;
    padding: clamp(0.5rem, 2vw, 1.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(2.9rem, 5.5vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.96;
    margin: 0;
    max-width: 14ch;
  }

  .page-intro {
    color: var(--muted);
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
    line-height: 1.58;
    margin: 1.6rem 0 0;
    max-width: 45em;
  }

  .question-navigator,
  .topic-directory {
    border-top: 1px solid var(--ink);
  }

  .question-navigator {
    padding: 1.35rem 0 clamp(3rem, 6vw, 5rem);
  }

  .question-navigator > header {
    max-width: 58rem;
  }

  .question-navigator h2,
  .directory-heading h2 {
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0;
  }

  .question-navigator > header > p,
  .directory-heading > p {
    color: var(--muted);
    line-height: 1.55;
  }

  .question-navigator > header > p {
    margin: 0.75rem 0 0;
  }

  .navigator-boundary {
    font-style: italic;
  }

  .question-table-wrap {
    margin-top: 1.5rem;
    overflow-x: auto;
    border-top: 1px solid var(--ink);
  }

  .question-table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    text-align: left;
  }

  .question-table th,
  .question-table td {
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.4;
  }

  .question-table thead th {
    color: var(--muted);
    font: 700 0.78rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .question-table tbody th {
    width: 39%;
    font-weight: 600;
  }

  .question-table tbody td:nth-child(2) { width: 35%; }

  .question-table a {
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 0.16em;
  }

  .question-table a:hover,
  .question-table a:focus-visible { color: var(--accent); }

  .topic-directory {
    padding-top: 1.25rem;
  }

  .directory-heading {
    display: grid;
    gap: 0 4rem;
    grid-template-columns: minmax(12rem, 0.8fr) minmax(20rem, 2fr);
    margin-bottom: 3rem;
  }

  .directory-heading > p {
    margin: 0.15rem 0 0;
  }

  .part-section {
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1.5rem 4rem;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 2fr);
    padding: 1.5rem 0 clamp(3rem, 6vw, 5rem);
    scroll-margin-top: 1rem;
  }

  .part-section > header h2 {
    font-size: clamp(1.45rem, 2.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
  }

  .part-section > header p,
  .group-summary {
    color: var(--muted);
    line-height: 1.5;
  }

  .part-section > header p {
    margin: 0.8rem 0 0;
  }

  .workflow-group {
    grid-column: 2;
  }

  .workflow-group + .workflow-group {
    margin-top: 1.5rem;
  }

  .workflow-group h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .group-summary {
    margin: 0.45rem 0 1rem;
  }

  .topic-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-list li {
    border-top: 1px solid var(--rule);
  }

  .topic-list a {
    align-items: baseline;
    color: inherit;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    line-height: 1.35;
    padding: 0.72rem 0;
    text-decoration: none;
  }

  .topic-list a::after {
    color: var(--accent);
    content: "→";
    flex: 0 0 auto;
  }

  .topic-list a:hover,
  .topic-list a:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 80rem) {
    .part-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .workflow-group {
      grid-column: 1;
    }
  }

  @media (max-width: 56.25rem) {
    .workflow-lede {
      padding-top: 0.5rem;
    }

    .directory-heading,
    .part-section {
      display: block;
    }

    .directory-heading > p,
    .workflow-group {
      margin-top: 2rem;
    }
  }

  @media (max-width: 44rem) {
    h1 {
      font-size: clamp(2.8rem, 12vw, 4.2rem);
    }

    .directory-heading > p,
    .workflow-group {
      margin-top: 1.4rem;
    }

    .question-table {
      min-width: 0;
    }

    .question-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .question-table,
    .question-table tbody,
    .question-table tr,
    .question-table th,
    .question-table td {
      display: block;
      width: auto;
    }

    .question-table tr { padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
    .question-table th,
    .question-table td { border: 0; padding: 0.22rem 0; }
    .question-table td:nth-child(2)::before { content: "Observable: "; font-weight: 700; }
    .question-table td:nth-child(3)::before { content: "Start: "; font-weight: 700; }
  }
</style>
