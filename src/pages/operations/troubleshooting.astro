---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import { workflowSections } from '../../lib/workflow';
import troubleshootingData from '../../../workflow/troubleshooting.json';

type OfficialSource = {
  id: string;
  title: string;
  organization: string;
  url: string;
  accessed_at: string;
};

type SymptomRecord = {
  slug: string;
  title: string;
  symptom: string;
  first_check: string;
  cause_classes: string[];
  inspect: string[];
  safe_next_action: string[];
  preserve_before_retry: string[];
  do_not_conclude: string;
  related_topic_slugs: string[];
  official_source_ids: string[];
};

type TroubleshootingDefinition = {
  schema_version: number;
  role: string;
  public_heading: string;
  intro: string;
  boundary: string;
  sources: OfficialSource[];
  records: SymptomRecord[];
};

type ResolvedRecord = SymptomRecord & {
  relatedTopics: Array<{ slug: string; title: string; href: string }>;
  officialSources: OfficialSource[];
};

const definition = troubleshootingData as TroubleshootingDefinition;
const expectedSlugs = [
  'job-stops-before-completion',
  'input-or-method-rejected',
  'scf-does-not-converge',
  'eigensolver-or-fermi-level-error',
  'restart-or-parent-artifact-rejected',
  'io-memory-or-parallel-failure',
  'geometry-looks-physically-wrong',
  'geometry-optimization-stalls',
  'symmetry-or-kq-mapping-mismatch',
  'imaginary-phonon-frequencies',
];
const allowedSourceHosts = new Set([
  'www.quantum-espresso.org',
  'vasp.at',
  'docs.abinit.org',
  'gpaw.readthedocs.io',
  'manual.cp2k.org',
]);
const topicBySlug = new Map(
  workflowSections.flatMap((section) =>
    section.groups.flatMap((group) => group.topics.map((topic) => [topic.slug, topic] as const)),
  ),
);

if (definition.schema_version !== 1 || definition.role !== 'symptom-first-static-support-route') {
  throw new Error('Troubleshooting: unsupported schema or route role');
}
if (JSON.stringify(definition.records.map((record) => record.slug)) !== JSON.stringify(expectedSlugs)) {
  throw new Error('Troubleshooting: symptom identity or order differs from the reviewed ten-record contract');
}

const sourceById = new Map<string, OfficialSource>();
for (const source of definition.sources) {
  if (sourceById.has(source.id)) throw new Error(`Troubleshooting: duplicate source ID ${source.id}`);
  const parsed = new URL(source.url);
  if (parsed.protocol !== 'https:' || !allowedSourceHosts.has(parsed.hostname)) {
    throw new Error(`Troubleshooting: source ${source.id} is not an allowed official HTTPS document`);
  }
  sourceById.set(source.id, source);
}

const resolvedRecords: ResolvedRecord[] = definition.records.map((record) => {
  const relatedTopics = record.related_topic_slugs.map((slug) => {
    const topic = topicBySlug.get(slug);
    if (!topic) throw new Error(`Troubleshooting: unresolved related topic ${slug}`);
    return { slug, title: topic.title, href: withBase(`operations/${slug}/`) };
  });
  const officialSources = record.official_source_ids.map((id) => {
    const source = sourceById.get(id);
    if (!source) throw new Error(`Troubleshooting: unresolved official source ${id}`);
    return source;
  });
  return { ...record, relatedTopics, officialSources };
});

const usedSourceIds = new Set(definition.records.flatMap((record) => record.official_source_ids));
for (const source of definition.sources) {
  if (!usedSourceIds.has(source.id)) throw new Error(`Troubleshooting: unused official source ${source.id}`);
}
---

<BaseLayout
  title="Troubleshoot a Calculation"
  description="A symptom-first DFT troubleshooting index: inspect the failure, preserve evidence, take one safe next action, and limit the conclusion."
  current="operations"
>
  <article class="troubleshooting-manual" data-troubleshooting-index>
    <header class="page-lede">
      <p class="section-label">Start with the evidence you have</p>
      <h1>{definition.public_heading}</h1>
      <p class="page-intro">{definition.intro}</p>
      <p class="page-boundary">{definition.boundary}</p>
    </header>

    <nav class="symptom-index" aria-labelledby="symptom-index-heading">
      <h2 id="symptom-index-heading">Start from the observed symptom</h2>
      <ol>
        {resolvedRecords.map((record) => (
          <li><a href={`#${record.slug}`}>{record.title}</a></li>
        ))}
      </ol>
    </nav>

    <div class="symptom-records">
      {resolvedRecords.map((record) => (
        <section class="symptom-record" id={record.slug} data-symptom-record={record.slug} aria-labelledby={`${record.slug}-heading`}>
          <header>
            <h2 id={`${record.slug}-heading`}>{record.title}</h2>
            <p>{record.symptom}</p>
          </header>

          <div class="primary-actions" data-primary-actions>
            <section class="action-step">
              <h3>Check this first</h3>
              <p>{record.first_check}</p>
            </section>
            <section class="action-step">
              <h3>Inspect now</h3>
              <ul>{record.inspect.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section class="action-step">
              <h3>Then take one safe action</h3>
              <ul>{record.safe_next_action.map((item) => <li>{item}</li>)}</ul>
            </section>
          </div>

          <aside class="claim-boundary" data-claim-boundary>
            <h3>Before you interpret the result</h3>
            <p>{record.do_not_conclude}</p>
          </aside>

          <details class="secondary-evidence" data-secondary-evidence>
            <summary>Show likely causes, evidence to preserve, and references</summary>
            <div class="secondary-grid">
              <section>
                <h3>Likely causes</h3>
                <ul>{record.cause_classes.map((item) => <li>{item}</li>)}</ul>
              </section>
              <section>
                <h3>Preserve before retry</h3>
                <ul>{record.preserve_before_retry.map((item) => <li>{item}</li>)}</ul>
              </section>
              <section>
                <h3>Related Research Workflow pages</h3>
                <ul class="link-list">
                  {record.relatedTopics.map((topic) => <li><a data-related-topic={topic.slug} href={topic.href}>{topic.title}</a></li>)}
                </ul>
              </section>
              <section>
                <h3>Official sources</h3>
                <ul class="link-list">
                  {record.officialSources.map((source) => (
                    <li><a data-official-source={source.id} href={source.url} rel="noreferrer">{source.organization}: {source.title}</a></li>
                  ))}
                </ul>
              </section>
            </div>
          </details>
        </section>
      ))}
    </div>

    <footer class="page-footer">
      <a href={withBase('operations/')}>Return to the Research Workflow</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .troubleshooting-manual {
    --ink: #181714;
    --muted: #666158;
    --rule: #d9d4ca;
    --accent: #8a3f28;
    color: var(--ink);
    max-width: 72rem;
  }

  .page-lede {
    max-width: 55rem;
    padding: clamp(0.5rem, 2vw, 1.4rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .section-label {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.7rem, 5.2vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin: 0;
    max-width: 17ch;
  }

  .page-intro,
  .page-boundary {
    font-size: clamp(1.04rem, 1.65vw, 1.22rem);
    line-height: 1.62;
    max-width: 46em;
  }

  .page-intro {
    margin: 1.5rem 0 0;
  }

  .page-boundary {
    color: var(--muted);
    margin: 0.9rem 0 0;
  }

  .symptom-index {
    border-top: 1px solid var(--ink);
    padding: 1.25rem 0 clamp(3rem, 6vw, 5rem);
  }

  .symptom-index h2 {
    font-size: clamp(1.45rem, 2.5vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.12;
    margin: 0;
  }

  .symptom-index ol {
    display: grid;
    gap: 0 2.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.7rem 0 0;
    padding-left: 1.6rem;
  }

  .symptom-index li {
    border-top: 1px solid var(--rule);
    line-height: 1.4;
    padding: 0.68rem 0 0.72rem 0.2rem;
  }

  a {
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.16em;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent);
  }

  .symptom-record {
    border-top: 1px solid var(--ink);
    padding: clamp(2.2rem, 5vw, 4rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    scroll-margin-top: 1rem;
  }

  .symptom-record > header {
    max-width: 55rem;
  }

  .symptom-record h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.08;
    margin: 0;
    max-width: 25ch;
  }

  .symptom-record > header p {
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.62;
    margin: 1rem 0 0;
    max-width: 47em;
  }

  .primary-actions {
    border-bottom: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2.2rem 0 0;
  }

  .action-step {
    min-width: 0;
    padding: 1rem clamp(1rem, 2.5vw, 1.7rem) 1.2rem 0;
  }

  .action-step + .action-step {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2.5vw, 1.7rem);
  }

  .action-step h3,
  .claim-boundary h3,
  .secondary-grid h3 {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.48;
    margin: 0;
  }

  .action-step p,
  .action-step ul,
  .claim-boundary p,
  .secondary-grid ul {
    color: var(--muted);
    line-height: 1.58;
    margin: 0.55rem 0 0;
    overflow-wrap: anywhere;
  }

  .action-step ul,
  .secondary-grid ul {
    padding-left: 1.2rem;
  }

  .action-step li + li,
  .secondary-grid li + li {
    margin-top: 0.4rem;
  }

  .claim-boundary {
    border-left: 2px solid var(--accent);
    margin: 1.35rem 0 0;
    max-width: 55rem;
    padding-left: 1rem;
  }

  .claim-boundary p {
    color: var(--ink);
  }

  .secondary-evidence {
    border-bottom: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
    margin-top: 1.6rem;
    padding: 0.9rem 0;
  }

  .secondary-evidence summary {
    cursor: pointer;
    font-weight: 700;
    line-height: 1.5;
  }

  .secondary-evidence[open] summary {
    margin-bottom: 1.1rem;
  }

  .secondary-grid {
    display: grid;
    gap: 1.35rem clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .secondary-grid > section {
    min-width: 0;
  }

  .link-list {
    list-style: none;
    padding-left: 0 !important;
  }

  .link-list a {
    font-weight: 650;
  }

  .page-footer {
    border-top: 1px solid var(--ink);
    font-weight: 700;
    padding: 1.4rem 0 0;
  }

  @media (max-width: 44rem) {
    h1 {
      font-size: clamp(2.65rem, 12vw, 4rem);
    }

    .symptom-index ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .primary-actions,
    .secondary-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .action-step {
      padding: 1rem 0 1.1rem;
    }

    .action-step + .action-step {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }
  }
</style>
