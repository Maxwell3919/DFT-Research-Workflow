---
import type { GetStaticPaths } from 'astro';
import { execFileSync } from 'node:child_process';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ContextualLinks from '../../../../components/ContextualLinks.astro';
import {
  practicalGuidePath,
  practicalKindLabel,
  practicalRouteSegment,
} from '../../../../lib/practical-guides';
import { getWorkflowTopics, type WorkflowTopic } from '../../../../lib/workflow';
import { getContextualNavigation } from '../../../../lib/contextual-navigation';
import { getResource, getResourcePath } from '../../../../lib/tools';
import { withBase } from '../../../../lib/paths';
import mediaDocument from '../../../../../workflow/practical-guide-media.json';
import evidenceDocument from '../../../../../workflow/practical-evidence.json';
import workflowsDocument from '../../../../../recipes/index.json';

type GateRecord = Record<string, { status?: string; summary?: string }>;
type EvidenceRecord = { guide_slug: string; evidence_class: string; case_id?: string };

type GuideProps = {
  guide: CollectionEntry<'practicalGuides'>;
  topic: WorkflowTopic;
  evidence: EvidenceRecord;
  caseGates?: GateRecord;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const topics = new Map(getWorkflowTopics().map((topic) => [topic.slug, topic]));
  const guides = await getCollection('practicalGuides');
  const evidenceByGuide = new Map((evidenceDocument.guides as EvidenceRecord[]).map((record) => [record.guide_slug, record]));

  return Promise.all(guides.map(async (guide) => {
    const topic = topics.get(guide.data.topic_slug);
    if (!topic) throw new Error(`Unknown practical-guide parent topic: ${guide.data.topic_slug}`);
    const evidence = evidenceByGuide.get(guide.data.guide_slug);
    if (!evidence) throw new Error(`Missing practical evidence record: ${guide.data.guide_slug}`);
    let caseGates: GateRecord | undefined;
    if (evidence.case_id) {
      const manifest = JSON.parse(await readFile(join(process.cwd(), 'examples', 'cases', evidence.case_id, 'manifest.json'), 'utf8'));
      caseGates = manifest.gates as GateRecord;
    }
    return {
      params: {
        topic: guide.data.topic_slug,
        category: practicalRouteSegment[guide.data.kind],
        slug: guide.data.guide_slug,
      },
      props: { guide, topic, evidence, caseGates } satisfies GuideProps,
    };
  }));
};

const { guide, topic, evidence, caseGates } = Astro.props as GuideProps;
const GuideContent = (await render(guide)).Content;
const kindLabel = practicalKindLabel[guide.data.kind];
const assets = mediaDocument.assets.filter((asset) => guide.data.media_ids.includes(asset.id));
const canonicalPath = practicalGuidePath(guide);
const publishedWorkflow = workflowsDocument.workflows.find((workflow) => workflow.case_id === evidence.case_id);
const publishedWorkflowStage = publishedWorkflow?.reader_route.stages.find((stage) => (
  'practical_guide_slugs' in stage
  && Array.isArray(stage.practical_guide_slugs)
  && stage.practical_guide_slugs.includes(guide.data.guide_slug)
));
const caseRoot = evidence.case_id ? `examples/cases/${evidence.case_id}/` : undefined;
const sourceRevision = (() => {
  const declared = process.env.GITHUB_SHA ?? process.env.SOURCE_REVISION;
  if (/^[a-f0-9]{40}$/i.test(declared ?? '')) return declared as string;
  try {
    const local = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
    if (/^[a-f0-9]{40}$/i.test(local)) return local;
  } catch {
    // The public link remains absent if no exact revision can be established.
  }
  return undefined;
})();
const caseUrl = caseRoot && sourceRevision
  ? `https://github.com/Maxwell3919/DFT-Research-Workflow/tree/${sourceRevision}/${caseRoot}`
  : undefined;
const caseManifestUrl = caseRoot && sourceRevision
  ? `https://github.com/Maxwell3919/DFT-Research-Workflow/blob/${sourceRevision}/${caseRoot}manifest.json`
  : undefined;
const isInterfaceWalkthrough = evidence.evidence_class === 'real-interface-walkthrough';
const gateRecords = Object.values(caseGates ?? {});
const recordedStatuses = gateRecords
  .map((record) => record.status?.trim().toUpperCase())
  .filter((status): status is string => Boolean(status));
const hasRecordedFailure = recordedStatuses.some((status) => status === 'FAIL' || status === 'FAILED');
const everyDeclaredCheckPassed = gateRecords.length > 0
  && recordedStatuses.length === gateRecords.length
  && recordedStatuses.every((status) => status === 'PASS' || status === 'PASSED');
const recordedOutcome = hasRecordedFailure
  ? 'The manifest records at least one failed check, so not every declared check passed. Inspect the failed evidence layer before using the case; an earlier program execution or analysis step may still have completed.'
  : everyDeclaredCheckPassed
    ? 'The manifest records successful completion of every check declared for this bounded case.'
    : 'The manifest does not record successful completion of every declared check. Treat this case as incomplete evidence; the record does not by itself establish whether every execution or analysis stage completed.';
const contextualNavigation = getContextualNavigation({ kind: 'practical', guide_slug: guide.data.guide_slug });
---

<BaseLayout
  title={guide.data.title}
  description={`${kindLabel} for ${topic.title}: ${guide.data.summary}`}
  current="operations"
>
  <article class="chapter practical-page" data-practical-path={canonicalPath}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={withBase('operations/')}>Research Workflow</a>
      <span aria-hidden="true"> / </span>
      <a href={withBase(`operations/${topic.slug}/`)}>{topic.title}</a>
      <span aria-hidden="true"> / </span>
      <span>{kindLabel}</span>
    </nav>

    <p class="operation-label">{kindLabel} · {topic.group}</p>
    <h1>{guide.data.title}</h1>
    <p class="page-intro">{guide.data.summary}</p>
    {publishedWorkflow && publishedWorkflowStage && (
      <p class="case-stage-link" data-workflow-stage-backlink>
        After learning the procedure, inspect it in the real case at{' '}
        <a href={withBase(`workflows/${publishedWorkflow.slug}/#reader-stage-${publishedWorkflowStage.id}`)}>
          {publishedWorkflow.title} · {publishedWorkflowStage.label}
        </a>.
      </p>
    )}

    <div class="article-content"><GuideContent /></div>

    {assets.length > 0 && (
      <section class="guide-media" aria-labelledby="guide-media-heading">
        <h2 id="guide-media-heading">Visual reference</h2>
        {assets.map((asset) => (
          <figure>
            <img src={withBase(asset.path)} alt={asset.alt} loading="lazy" />
            <figcaption>
              {asset.caption}{' '}
              {asset.source_url && <a href={asset.source_url}>Source.</a>}{' '}
              <a href={withBase(asset.path)}>Open the full-size figure.</a>
            </figcaption>
          </figure>
        ))}
      </section>
    )}

    <div class="guide-ways guide-meta">
      <p>
        <strong>Ways to work:</strong>{' '}
        {guide.data.interfaces.length > 0 ? `${guide.data.interfaces.join(' · ')} · ` : ''}
        <span class="tool-list">
          {guide.data.tools.map((slug) => {
            const resource = getResource(slug);
            return <a class="tool-tag" href={withBase(getResourcePath(resource))}>{resource.name}</a>;
          })}
        </span>
      </p>
      <p><strong>Companion checked with:</strong> {guide.data.tested_versions.join('; ')}.</p>
    </div>

    {(evidence.case_id || guide.data.tested_versions.length > 0) && (
      <details class="reproducibility-note evidence-note">
        <summary>Reproducibility note</summary>
        <p>
          The companion material was checked with {guide.data.tested_versions.join('; ')}.
          It tests only the bounded software or analysis behaviour described here; it does not establish numerical convergence, model validity, or a material property.
        </p>
        {evidence.case_id && <p>{recordedOutcome}</p>}
        {caseUrl && caseManifestUrl && (
          <p>
            <a href={caseUrl}>Open the exact case record</a> or its <a href={caseManifestUrl}>manifest</a>.
          </p>
        )}
        {publishedWorkflow && (
          <p>
            <a href={withBase(
              publishedWorkflowStage
                ? `workflows/${publishedWorkflow.slug}/#reader-stage-${publishedWorkflowStage.id}`
                : `workflows/${publishedWorkflow.slug}/`
            )}>Read the Worked Workflow</a>.
          </p>
        )}
        {isInterfaceWalkthrough && <p>A captured interface proves only what was displayed at the recorded time; it does not validate the structure or any DFT result.</p>}
      </details>
    )}

    {contextualNavigation && <ContextualLinks navigation={contextualNavigation} />}

    <p class="directory-link">
      <a href={withBase(`operations/${topic.slug}/`)}>Return to {topic.title}</a>
    </p>
  </article>
</BaseLayout>
