---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getLegacyOperations,
  getOperations,
  type CoreOperation,
  type LegacyOperation,
} from '../../lib/operations';
import { withBase } from '../../lib/paths';

type CoreProps = {
  kind: 'core';
  operation: CoreOperation;
  narrative: CollectionEntry<'coreOperations'> | undefined;
};

type LegacyProps = {
  kind: 'legacy';
  operation: LegacyOperation;
};

type Props = CoreProps | LegacyProps;

export const getStaticPaths: GetStaticPaths = async () => {
  const narratives = await getCollection('coreOperations');
  const narrativeById = new Map(narratives.map((entry) => [entry.data.operation_id, entry]));
  const transitionalCorePaths = getOperations().map((operation) => ({
    params: { slug: operation.slug },
    props: {
      kind: 'core',
      operation,
      narrative: narrativeById.get(operation.id),
    } satisfies CoreProps,
  }));
  const legacyPaths = getLegacyOperations().map((operation) => ({
    params: { slug: operation.slug },
    props: {
      kind: 'legacy',
      operation,
    } satisfies LegacyProps,
  }));
  return [...transitionalCorePaths, ...legacyPaths];
};

const page = Astro.props as Props;
const title = page.operation.title ?? page.operation.name;
const description = page.kind === 'core' ? page.operation.definition : page.operation.disposition;
const Narrative = page.kind === 'core' && page.narrative ? (await render(page.narrative)).Content : null;
---

<BaseLayout title={title} description={description} current="operations">
  <article class="chapter">
    <p class="breadcrumb"><a href={withBase('operations/')}>Research Workflow</a></p>
    <p class="operation-label">Transitional route</p>
    <h1>{title}</h1>

    <div class="legacy-notice">
      <p>
        This URL is retained while the site migrates to the researcher-scale A–E workflow. It is not a current chapter number or evidence that DFT research contains a fixed number of operations.
      </p>
    </div>

    {page.kind === 'core' && Narrative && (
      <div class="article-content"><Narrative /></div>
    )}

    <p class="directory-link"><a href={withBase('operations/')}>Return to the Research Workflow</a></p>
  </article>
</BaseLayout>
