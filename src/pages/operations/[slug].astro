---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthoritativeReferences from '../../components/AuthoritativeReferences.astro';
import ContextualLinks from '../../components/ContextualLinks.astro';
import authorityDocument from '../../../sources/topic-authority.json';
import {
  getLegacyOperations,
  getOperations,
  type CoreOperation,
  type LegacyOperation,
} from '../../lib/operations';
import {
  practicalGuidePath,
  practicalSectionLabel,
  type PracticalGuideKind,
} from '../../lib/practical-guides';
import { getWorkflowTopics, type WorkflowTopic } from '../../lib/workflow';
import { getContextualNavigation } from '../../lib/contextual-navigation';
import { withBase } from '../../lib/paths';
import evidenceDocument from '../../../workflow/practical-evidence.json';

type TopicProps = {
  kind: 'topic';
  topic: WorkflowTopic;
  narrative: CollectionEntry<'topics'> | undefined;
  practicalGuides: CollectionEntry<'practicalGuides'>[];
};

type CoreProps = {
  kind: 'core';
  operation: CoreOperation;
  narrative: CollectionEntry<'coreOperations'> | undefined;
};

type LegacyProps = {
  kind: 'legacy';
  operation: LegacyOperation;
};

type Props = TopicProps | CoreProps | LegacyProps;

export const getStaticPaths: GetStaticPaths = async () => {
  const topicNarratives = await getCollection('topics');
  const topicNarrativeBySlug = new Map(topicNarratives.map((entry) => [entry.data.topic_slug, entry]));
  const practicalGuides = await getCollection('practicalGuides');
  const syntheticOnlyGuides = new Set(
    evidenceDocument.guides
      .filter((record) => record.evidence_class === 'synthetic-only')
      .map((record) => record.guide_slug),
  );
  const topicPaths = getWorkflowTopics().map((topic) => ({
    params: { slug: topic.slug },
    props: {
      kind: 'topic',
      topic,
      narrative: topicNarrativeBySlug.get(topic.slug),
      practicalGuides: practicalGuides
        .filter((entry) => entry.data.topic_slug === topic.slug && !syntheticOnlyGuides.has(entry.data.guide_slug))
        .sort((left, right) => left.data.title.localeCompare(right.data.title)),
    } satisfies TopicProps,
  }));

  const coreNarratives = await getCollection('coreOperations');
  const coreNarrativeById = new Map(coreNarratives.map((entry) => [entry.data.operation_id, entry]));
  const transitionalCorePaths = getOperations().map((operation) => ({
    params: { slug: operation.slug },
    props: {
      kind: 'core',
      operation,
      narrative: coreNarrativeById.get(operation.id),
    } satisfies CoreProps,
  }));

  const legacyPaths = getLegacyOperations().map((operation) => ({
    params: { slug: operation.slug },
    props: {
      kind: 'legacy',
      operation,
    } satisfies LegacyProps,
  }));

  return [...topicPaths, ...transitionalCorePaths, ...legacyPaths];
};

const page = Astro.props as Props;
const title = page.kind === 'topic'
  ? page.topic.title
  : page.kind === 'core'
    ? page.operation.name
    : page.operation.title;
const description = page.kind === 'topic'
  ? `${page.topic.section} · ${page.topic.sectionTitle}: ${page.topic.title}.`
  : page.kind === 'core'
    ? page.operation.definition
    : page.operation.disposition;
const Narrative = page.kind === 'topic' && page.narrative
  ? (await render(page.narrative)).Content
  : page.kind === 'core' && page.narrative
    ? (await render(page.narrative)).Content
    : null;
const practicalOrder: PracticalGuideKind[] = ['implementation', 'worked-example', 'visual-note'];
const authorityEntry = page.kind === 'topic'
  ? authorityDocument.entries.find((entry) => entry.topic_slug === page.topic.slug)
  : undefined;
const authorityTextbook = authorityEntry && authorityEntry.textbook_key !== 'none'
  ? authorityDocument.textbooks[authorityEntry.textbook_key as keyof typeof authorityDocument.textbooks]
  : undefined;
const contextualNavigation = page.kind === 'topic'
  ? getContextualNavigation({ kind: 'topic', slug: page.topic.slug })
  : undefined;
---

<BaseLayout title={title} description={description} current="operations">
  <article class="chapter">
    <p class="breadcrumb"><a href={withBase('operations/')}>Research Workflow</a></p>

    {page.kind === 'topic' ? (
      <>
        <p class="operation-label">
          {page.topic.section === 'D'
            ? `${page.topic.group} · ${page.topic.groupTitle}`
            : `${page.topic.section} · ${page.topic.sectionTitle}`}
        </p>
        <h1>{page.topic.title}</h1>
        {page.topic.section === 'D' && (
          <p class="page-intro">
            Part D branches by the observable required to answer the research question. This topic is chosen only when that quantity is needed; it is not a required step in every DFT study.
          </p>
        )}
        {page.topic.section === 'E' && (
          <p class="page-intro">
            Work in E can send a study back to A, B, C, or the relevant D branch when validation, documentation, or preservation reveals a gap in the evidence.
          </p>
        )}
        {page.practicalGuides.length > 0 && (
          <p class="practical-jump">
            <a href="#practical-resources-heading">Go directly to practical resources for this task</a>.
          </p>
        )}
        {Narrative ? (
          <div class="article-content"><Narrative /></div>
        ) : (
          <p class="page-intro">
            This stable destination is reserved for a later reviewed content batch. The final article will follow the scientific logic of this topic rather than a uniform article template.
          </p>
        )}

        {page.practicalGuides.length > 0 && (
          <section class="practical-resources" aria-labelledby="practical-resources-heading">
            <header>
              <h2 id="practical-resources-heading">Practical resources</h2>
              <p>Implementation detail and bounded examples for this researcher-scale task.</p>
            </header>
            {practicalOrder.map((kind) => {
              const entries = page.practicalGuides.filter((entry) => entry.data.kind === kind);
              if (entries.length === 0) return null;
              return (
                <section class="practical-group" aria-labelledby={`practical-${kind}`}>
                  <h3 id={`practical-${kind}`}>{practicalSectionLabel[kind]}</h3>
                  <ul class="practical-card-list">
                    {entries.map((entry) => (
                      <li>
                        <a href={withBase(practicalGuidePath(entry))}>{entry.data.title}</a>
                        <p>{entry.data.summary}</p>
                        <div class="tool-list" aria-label="Tools">
                          {entry.data.tools.map((tool) => <span class="tool-tag">{tool}</span>)}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </section>
        )}

        {contextualNavigation && <ContextualLinks navigation={contextualNavigation} />}

        {authorityEntry && (
          <AuthoritativeReferences entry={authorityEntry} textbook={authorityTextbook} />
        )}
      </>
    ) : (
      <>
        <p class="operation-label">Transitional route</p>
        <h1>{title}</h1>
        <div class="legacy-notice">
          <p>
            This URL is retained while useful material is migrated into the A–E workflow. It is not a current chapter number or evidence that DFT research contains a fixed number of operations.
          </p>
        </div>
        {Narrative && <div class="article-content"><Narrative /></div>}
      </>
    )}

    <p class="directory-link"><a href={withBase('operations/')}>Return to the Research Workflow</a></p>
  </article>
</BaseLayout>
