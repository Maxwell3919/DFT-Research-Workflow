---
import type { GetStaticPaths } from 'astro';
import recipesDocument from '../../../recipes/index.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

type Props = { destination: string | null };

export const getStaticPaths: GetStaticPaths = async () => {
  return recipesDocument.legacy_recipe_redirects.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { destination: recipe.destination } satisfies Props,
  }));
};

const { destination } = Astro.props as Props;
const target = withBase(destination ? `workflows/${destination}/` : 'workflows/');
---

<BaseLayout title="Moved to Worked Workflows" description="This legacy recipe has moved to Worked Workflows." redirectTo={target}>
  <article class="chapter">
    <h1>Moved to Worked Workflows</h1>
    <p class="page-intro">This legacy recipe has moved to <a href={target}>Worked Workflows</a>.</p>
  </article>
</BaseLayout>
