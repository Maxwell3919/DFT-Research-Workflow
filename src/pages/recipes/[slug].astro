---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRecipes, type Recipe } from '../../lib/operations';
import { withBase } from '../../lib/paths';

type Props = { recipe: Recipe; narrative: CollectionEntry<'recipes'> | undefined };

export const getStaticPaths: GetStaticPaths = async () => {
  const narratives = await getCollection('recipes');
  const narrativeBySlug = new Map(narratives.map((entry) => [entry.data.recipe_slug, entry]));
  return getRecipes().map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe, narrative: narrativeBySlug.get(recipe.slug) } satisfies Props,
  }));
};

const { recipe, narrative } = Astro.props as Props;
const Narrative = narrative ? (await render(narrative)).Content : null;
---

<BaseLayout title={recipe.title} description={`Research workflow: ${recipe.title}.`} current="recipes">
  <article class="chapter">
    <p class="breadcrumb"><a href={withBase('recipes/')}>Workflow Recipes</a></p>
    <p class="operation-label">Research workflow</p>
    <h1>{recipe.title}</h1>
    <p class="operation-summary">
      This page will explain one way to combine researcher-scale tasks for the stated scientific goal. It is not an atomic operation or a universal execution sequence.
    </p>

    {Narrative && <div class="article-content"><Narrative /></div>}

    <p class="directory-link"><a href={withBase('recipes/')}>Return to Workflow Recipes</a></p>
  </article>
</BaseLayout>
