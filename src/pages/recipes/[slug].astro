---
import type { GetStaticPaths } from 'astro';
import recipesDocument from '../../../recipes/index.json';
import { withBase } from '../../lib/paths';

type Props = { destination: string | null };

export const getStaticPaths: GetStaticPaths = async () => {
  return recipesDocument.legacy_recipe_redirects.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { destination: recipe.destination } satisfies Props,
  }));
};

const { destination } = Astro.props as Props;
const target = withBase(destination ? `workflows/${destination}/` : 'workflows/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Moved to Worked Workflows</title>
  </head>
  <body>
    <p>This legacy recipe has moved to <a href={target}>Worked Workflows</a>.</p>
  </body>
</html>
