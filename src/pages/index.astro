---
import BaseLayout from '../layouts/BaseLayout.astro';
import { workflowSections } from '../lib/workflow';
import { withBase } from '../lib/paths';

const flowLabels = {
  A: 'Structure & Model',
  B: 'Method & Numerical Setup',
  C: 'Reference State',
  D: 'Target Calculation',
  E: 'Validation',
} as const;
---

<BaseLayout
  title="DFT Research Workflow"
  description="A human-first, software-neutral research manual for turning scientific questions into supported DFT conclusions."
  current="home"
  wide
>
  <article class="manual-home">
    <header class="home-lede">
      <h1>DFT Research Workflow</h1>
      <p class="home-intro">
        Use this manual to turn a scientific question into a calculation you can execute and a conclusion you can defend. Start with the scientific question, choose the required observable, prepare the model and numerical setup, establish a reference state, run only the target calculation you need, and validate the result before making a claim. Where execution evidence exists, practical guides and worked workflows identify the file to prepare, the command to run, the output to inspect, and what the recorded evidence establishes. They also state which numerical, structural, or physical conditions remain untested, so a finished job is not mistaken for a supported conclusion.
      </p>
    </header>

    <section class="question-chain" aria-labelledby="question-chain-heading">
      <h2 id="question-chain-heading">Move from a question to a defensible claim</h2>
      <ol aria-label="Scientific question to supported scientific conclusion">
        <li class="chain-bookend"><span class="chain-title">Scientific Question</span></li>
        <li class="chain-bookend"><span class="chain-title">Required Observable</span></li>
        {workflowSections.map((section) => (
          <li class="chain-part">
            <a href={withBase(`operations/#part-${section.id.toLowerCase()}`)} aria-label={`${section.id}, ${section.title}`}>
              <span class="chain-id">{section.id}</span>
              <span class="chain-title">{flowLabels[section.id as keyof typeof flowLabels]}</span>
            </a>
          </li>
        ))}
        <li class="chain-bookend chain-conclusion"><span class="chain-title">Supported Scientific Conclusion</span></li>
      </ol>
      <p class="return-note">
        This is not a one-way pipeline. Validation can return the study to <a href={withBase('operations/#part-a')}>the model</a>, <a href={withBase('operations/#part-b')}>numerical setup</a>, <a href={withBase('operations/#part-c')}>reference state</a>, or <a href={withBase('operations/#part-d')}>calculation branch</a>.
      </p>
    </section>

    <section class="solver-boundary" aria-labelledby="solver-boundary-heading">
      <div>
        <p class="section-label">One boundary to remember</p>
        <h2 id="solver-boundary-heading">SCF convergence is one inner numerical condition.</h2>
      </div>
      <p>
        <strong>Electronic self-consistency</strong> is the inner fixed-geometry solver, while program termination is a separate check. A <strong>Numerical convergence loop</strong> must still test the target observable. SCF convergence does not establish structural, observable, or scientific convergence.
      </p>
    </section>

    <nav class="manual-entries" aria-labelledby="entry-heading">
      <h2 id="entry-heading">Start where you are</h2>
      <a href={withBase('operations/')}>
        <strong>Start the Research Workflow</strong>
        <span>Choose the required observable, then move through the model, setup, reference state, calculation, and validation.</span>
      </a>
      <a href={withBase('workflows/')}>
        <strong>Follow a Worked Workflow</strong>
        <span>Follow a human research route across sources, visual inspection, files, commands, outputs, checks, and claim boundaries.</span>
      </a>
      <a href={withBase('tools/')}>
        <strong>Find a Tool</strong>
        <span>Locate software or a data service by the research task it helps you perform.</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .manual-home {
    --ink: #181714;
    --muted: #666158;
    --rule: #d9d4ca;
    --accent: #8a3f28;
    color: var(--ink);
    margin-inline: auto;
    max-width: 76rem;
  }

  .home-lede {
    max-width: 52rem;
    padding: clamp(0.5rem, 2vw, 1.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(3.5rem, 7vw, 6.2rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
    margin: 0;
    max-width: 13ch;
  }

  .home-intro {
    color: var(--muted);
    font-size: clamp(1.15rem, 1.8vw, 1.38rem);
    line-height: 1.55;
    margin: 1.75rem 0 0;
    max-width: 40em;
  }

  .question-chain,
  .solver-boundary,
  .manual-entries {
    border-top: 1px solid var(--ink);
    padding: 1.4rem 0 clamp(2.8rem, 5vw, 4.5rem);
  }

  .question-chain h2,
  .manual-entries h2 {
    font-size: 1.22rem;
    letter-spacing: -0.01em;
    margin: 0 0 1.4rem;
  }

  .question-chain ol {
    display: grid;
    gap: 1rem clamp(0.8rem, 1.4vw, 1.35rem);
    grid-template-columns: repeat(8, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .question-chain li {
    align-content: start;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
  }

  .question-chain li:not(:last-child)::after {
    align-self: center;
    color: var(--accent);
    content: "→";
    font-size: 0.9rem;
    grid-column: 2;
    grid-row: 1;
  }

  .chain-bookend {
    font-weight: 700;
  }

  .chain-part a {
    color: inherit;
    display: grid;
    gap: 0.35rem;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
    text-decoration: none;
  }

  .chain-id {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
  }

  .chain-title {
    display: block;
    font-size: 0.94rem;
    line-height: 1.28;
    overflow-wrap: break-word;
  }

  .chain-part a:hover .chain-title,
  .chain-part a:focus-visible .chain-title,
  .return-note a:hover,
  .return-note a:focus-visible {
    color: var(--accent);
  }

  .return-note {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 1.5rem 0 0;
    max-width: 58rem;
  }

  .return-note a {
    color: var(--ink);
    font-weight: 700;
  }

  .solver-boundary {
    display: grid;
    gap: 1.25rem clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(16rem, 0.85fr) minmax(20rem, 1.4fr);
  }

  .section-label {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0 0 0.55rem;
  }

  .solver-boundary h2 {
    font-size: clamp(1.55rem, 2.3vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.12;
    margin: 0;
  }

  .solver-boundary > p {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.55;
    margin: 0;
    max-width: 42rem;
  }

  .manual-entries {
    padding-bottom: 1rem;
  }

  .manual-entries > a {
    align-items: baseline;
    border-top: 1px solid var(--rule);
    color: inherit;
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(18rem, 1.45fr) auto;
    padding: 1.2rem 0;
    text-decoration: none;
  }

  .manual-entries > a::after {
    color: var(--accent);
    content: "→";
  }

  .manual-entries strong {
    font-size: 1.16rem;
  }

  .manual-entries span {
    color: var(--muted);
    line-height: 1.45;
  }

  .manual-entries > a:hover strong,
  .manual-entries > a:focus-visible strong {
    color: var(--accent);
  }

  @media (max-width: 67.99rem) {
    .question-chain ol {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .question-chain li:nth-child(1),
    .question-chain li:nth-child(2) {
      grid-column: span 3;
    }

    .question-chain li:nth-child(n + 3) {
      grid-column: span 2;
    }

    .question-chain li:nth-child(2)::after,
    .question-chain li:nth-child(5)::after {
      content: "↓";
    }
  }

  @media (max-width: 44rem) {
    .home-lede {
      padding-top: 0;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4.4rem);
      max-width: 10ch;
    }

    .question-chain ol {
      gap: 0;
      grid-template-columns: 1fr;
    }

    .question-chain li:nth-child(n) {
      border-top: 1px solid var(--rule);
      grid-column: 1 / -1;
      padding: 0.65rem 0;
    }

    .question-chain li:first-child {
      border-top: 0;
    }

    .question-chain li:not(:last-child)::after {
      content: "↓";
    }

    .solver-boundary {
      display: block;
    }

    .solver-boundary > p {
      margin-top: 1rem;
    }

    .manual-entries > a {
      gap: 0.4rem 1rem;
      grid-template-columns: 1fr auto;
    }

    .manual-entries > a span {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .manual-entries > a::after {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
