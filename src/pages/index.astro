---
import BaseLayout from '../layouts/BaseLayout.astro';
import { workflowSections } from '../lib/workflow';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="DFT Research Workflow"
  description="A software-neutral guide to researcher-scale DFT tasks, target calculations, validation, and reproducibility."
  current="home"
>
  <h1>DFT Research Workflow</h1>
  <p class="home-intro">
    DFT Research Workflow explains how researchers move from a material structure to interpretable, validated, and reproducible results. The site follows five broad parts: Structures, Calculation Preparation, Reference-State Calculations, Target Calculations, and Research Completion. These parts are a learning map rather than a claim that every study follows one fixed sequence. Target calculations form a branching library: band structures, density of states, phonons, defects, transport, optical response, electron–phonon coupling, superconductivity, and other calculations are explained as distinct scientific tasks when their methods and evidence differ. Each article is organized according to its subject instead of repeating a uniform contract. Start with the <a href={withBase('operations/')}>Research Workflow</a>, then use <a href={withBase('recipes/')}>Workflow Recipes</a> for complete examples and <a href={withBase('framework/')}>Framework</a> for cross-cutting concepts.
  </p>

  <section class="parts-overview" aria-labelledby="workflow-heading">
    <h2 id="workflow-heading">Research workflow</h2>
    <ol>
      {workflowSections.map((section) => (
        <li>
          <a href={withBase(`operations/#part-${section.id.toLowerCase()}`)}>{section.id} · {section.title}</a>
          <span>{section.summary}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="parts-overview" aria-labelledby="supporting-content-heading">
    <h2 id="supporting-content-heading">Supporting content</h2>
    <ol>
      <li><a href={withBase('recipes/')}>Workflow Recipes</a><span>Examples of how tasks combine for specific research goals.</span></li>
      <li><a href={withBase('framework/')}>Framework</a><span>Workflow relations, evidence boundaries, provenance, and reproducibility.</span></li>
    </ol>
  </section>
</BaseLayout>
