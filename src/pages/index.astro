---
import BaseLayout from '../layouts/BaseLayout.astro';
import { parts } from '../lib/operations';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="DFT Research Workflow"
  description="A software-neutral guide to density-functional-theory research, organized around 35 practical operations."
  current="home"
>
  <h1>DFT Research Workflow</h1>
  <p class="home-intro">
    DFT Research Workflow is a comprehensive, software-neutral guide to the practical process of density-functional-theory research. It follows a study from defining a scientific question, preparing source structures, and choosing a computational model through numerical convergence, calculation, property analysis, result inspection, and reproducibility. Rather than teaching one code or utility, the site is organized around the operations researchers carry out across DFT projects. The framework currently provides the complete chapter sequence and stable routes; detailed chapters will be written and reviewed one operation at a time. Start with the <a href={withBase('operations/')}>Operations directory</a>.
  </p>

  <section class="parts-overview" aria-labelledby="contents-heading">
    <h2 id="contents-heading">Contents</h2>
    <ol>
      {parts.map((part) => (
        <li>
          <a href={withBase(`operations/#${part.anchor}`)}>{part.label}</a>
          <span>{part.range}</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
