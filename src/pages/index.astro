---
import BaseLayout from '../layouts/BaseLayout.astro';
import StageRail from '../components/StageRail.astro';
import stagesData from '../data/stages.json';
import operationsData from '../data/operations.json';
import { branches } from '../data/branches';
---

<BaseLayout title="DFT Research Workflow" description="从科学问题到经过验证、可复现结果的 DFT 研究工作流。">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker"><span>RESEARCH MAP</span> / not a workflow engine</p>
      <h1>可靠的 DFT 研究，<br /><em>不是一条提交命令。</em></h1>
      <p class="hero-lead">从“为什么算”出发，经过结构、协议、收敛、HPC 与性质分支，最终抵达证据边界清楚、可以复核的科学主张。</p>
      <div class="hero-actions">
        <a class="button primary" href="/workflow/">进入完整工作流 <span>→</span></a>
        <a class="button ghost" href="/evidence/">先看七层证据门</a>
      </div>
      <div class="hero-stats" aria-label="网站覆盖范围">
        <span><b>{stagesData.length}</b><small>研究阶段</small></span>
        <span><b>{operationsData.length}</b><small>operations</small></span>
        <span><b>{branches.length}</b><small>性质分支</small></span>
        <span><b>0</b><small>生产作业</small></span>
      </div>
    </div>
    <div class="hero-visual" aria-label="DFT 研究从问题到主张的示意图">
      <div class="orbital orbital-a"></div><div class="orbital orbital-b"></div><div class="orbital orbital-c"></div>
      <div class="hero-core"><span>Q</span><small>scientific<br />question</small></div>
      <div class="signal signal-1"><i></i><span>structure</span></div>
      <div class="signal signal-2"><i></i><span>protocol</span></div>
      <div class="signal signal-3"><i></i><span>evidence</span></div>
      <div class="signal signal-4"><i></i><span>claim</span></div>
      <p class="visual-caption">一项结果的可信度，取决于整条证据链，而非最后一个输出字段。</p>
    </div>
  </section>

  <section class="manifesto-band">
    <div class="shell manifesto-grid">
      <p class="section-index">01 / WHY</p>
      <blockquote>“我们尚未把一个可靠的 DFT 研究者究竟如何工作理解和表达清楚，因此现在直接自动化，极易把错误抽象固化进代码。”</blockquote>
      <p>这个网站先保存判断结构：哪些选择必须由研究者做，哪些环节可以被工具辅助，哪些成熟后才可能成为可验证的自动化单元。</p>
    </div>
  </section>

  <section class="shell overview-section">
    <div class="section-heading">
      <div><p class="section-index">02 / COMMON TRUNK</p><h2>八个阶段，共同构成研究主干</h2></div>
      <p>每个阶段都产生可审查的交付物，也都有一种常见的“看似完成”。点击阶段查看它的决策、失败模式与 operation 契约。</p>
    </div>
    <StageRail />
  </section>

  <section class="branch-preview shell">
    <div class="section-heading">
      <div><p class="section-index">03 / PROPERTY BRANCHES</p><h2>离开共同主干后，验收开始分叉</h2></div>
      <a class="text-link" href="/branches/">比较全部分支 →</a>
    </div>
    <div class="branch-grid">
      {branches.map((branch) => (
        <a class={`branch-card accent-${branch.accent}`} href={`/branches/${branch.id}/`}>
          <span>{branch.number}</span><h3>{branch.title}</h3><p>{branch.question}</p><small>{branch.convergence.length} 个关键收敛轴</small>
        </a>
      ))}
    </div>
  </section>

  <section class="boundary-section">
    <div class="shell boundary-grid">
      <div><p class="section-index">04 / STOP THE LEAP</p><h2>不要跨过中间的证据门</h2></div>
      <div class="boundary-equation" aria-label="证据层级">
        <span>RUNNING</span><i>≠</i><span>JOB DONE</span><i>≠</i><span>CONVERGED</span><i>≠</i><span>VALIDATED</span><i>≠</i><span>ACCEPTED</span>
      </div>
      <a class="button light" href="/evidence/">逐层检查证据门 <span>→</span></a>
    </div>
  </section>
</BaseLayout>
