---
import { readFile } from 'node:fs/promises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import workflowsDocument from '../../../recipes/index.json';

type ReaderRoute = {
  schema_version: number;
  stages: Array<{ id: string }>;
};

type Workflow = {
  slug: string;
  title: string;
  case_id: string;
  material: string;
  summary: string;
  history_kind: string;
  evidence_boundary: string;
  continuity_boundary: string;
  claim_boundary: string;
  reader_route: ReaderRoute;
};

const workflows = workflowsDocument.workflows as Workflow[];

async function assertPublishedCase(workflow: Workflow) {
  const root = new URL(`../../../examples/cases/${workflow.case_id}/`, import.meta.url);
  try {
    await Promise.all([
      readFile(new URL('README.md', root), 'utf8'),
      readFile(new URL('manifest.json', root), 'utf8'),
    ]);
  } catch {
    throw new Error(
      `Worked workflow ${workflow.slug} is blocked: examples/cases/${workflow.case_id}/README.md and manifest.json must both exist before it can be published.`,
    );
  }
}

await Promise.all(workflows.map(assertPublishedCase));
---

<BaseLayout title="Worked Workflows" description="Real DFT cases organized around what a researcher opens, runs, inspects, decides, and preserves." current="workflows">
  <h1>Worked Workflows</h1>
  <p class="page-intro">
    Choose a case by its material and scientific question, then open it. Each case follows the browser, viewer, editor, terminal, or HPC actions a researcher would take, the outputs and figures to inspect, and the next decision. Reproducibility evidence remains available inside the case. A case documents only its stated route; it does not replace the A–E Research Workflow or support conclusions beyond the checks shown.
  </p>
  <ol class="directory-list" data-workflow-directory>
    {workflows.map((workflow) => (
      <li
        data-workflow-slug={workflow.slug}
        data-case-id={workflow.case_id}
        data-history-kind={workflow.history_kind}
        data-reader-route-count={workflow.reader_route.stages.length}
      >
        <a href={withBase(`workflows/${workflow.slug}/`)}>{workflow.title}</a>
        <span>{workflow.summary}</span>
      </li>
    ))}
  </ol>
</BaseLayout>
