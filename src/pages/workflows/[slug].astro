---
import type { GetStaticPaths } from 'astro';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { readFile } from 'node:fs/promises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import workflowsDocument from '../../../recipes/index.json';
import topicRegistryDocument from '../../../workflow/topics.json';

const topicTitleBySlug = new Map<string, string>();
const indexTopicTitles = (value: unknown): void => {
  if (Array.isArray(value)) {
    value.forEach(indexTopicTitles);
    return;
  }
  if (!value || typeof value !== 'object') return;
  const record = value as Record<string, unknown>;
  if (typeof record.slug === 'string' && typeof record.title === 'string') {
    topicTitleBySlug.set(record.slug, record.title);
  }
  Object.values(record).forEach(indexTopicTitles);
};
indexTopicTitles(topicRegistryDocument);

type ActionRecord = {
  label: string;
  cwd: string;
  commands: string[];
  boundary: string;
};

type StartHere = {
  repository_url: string;
  source_revision_token: string;
  working_directory: string;
  case_root: string;
  acquisition_commands: string[];
  first_action: ActionRecord;
};

type ExecutionContext = {
  id: string;
  label: string;
  allowed_when: string;
  boundary: string;
};

type EvidenceTrack = {
  id: string;
  label: string;
  launches_dft: boolean;
  commands: string[];
  output_policy: string;
  audit: string[];
  parse_plot_boundary: string;
  boundary: string;
};

type SourceRecord = {
  id: string;
  label: string;
  role: string;
  url?: string;
  case_files: string[];
  identity?: string[];
  boundary: string;
};

type RecordConflict = {
  id: string;
  case_files: string[];
  preferred_record: string;
  status: string;
  boundary: string;
};

type ReaderRouteStage = {
  id: string;
  label: string;
  purpose: string;
  topic_slugs: string[];
  coverage: string;
  case_files: string[];
  execution_route_ids: string[];
  command_stages: string[];
  artifact_paths: string[];
  action?: ActionRecord;
  assessment?: string;
  observable_convergence?: string;
  boundary: string;
};

type ReaderRoute = {
  schema_version: number;
  stages: ReaderRouteStage[];
};

type Workflow = {
  slug: string;
  title: string;
  case_id: string;
  excerpt_path: string;
  material: string;
  summary: string;
  history_kind: string;
  evidence_boundary: string;
  continuity_boundary: string;
  continuous_execution_route_ids: string[];
  claim_boundary: string;
  start_here: StartHere;
  execution_contexts: ExecutionContext[];
  evidence_tracks: EvidenceTrack[];
  source_records: SourceRecord[];
  record_conflicts?: RecordConflict[];
  reader_route: ReaderRoute;
};

type CommandRecord = {
  stage?: string;
  command?: string;
  exit_code?: number | null;
  route_id?: string;
  record_kind?: string;
  evidence_scope?: string;
  exit_code_scope?: string;
  input_artifacts?: string[];
  parent_artifacts?: string[];
  output_artifacts?: string[];
};

type ExecutionRoute = {
  route_id?: string;
  label?: string;
  timing?: { started_at?: string | null; completed_at?: string | null; scope?: string };
  exact_command_status?: string;
  exact_exit_code_status?: string;
  ancestry?: string[];
  boundary?: string;
};

type CaseManifest = {
  evidence_class?: string;
  public_host_label?: string;
  software?: Array<{ name?: string; version?: string; interface?: string }>;
  commands?: CommandRecord[];
  artifacts?: Array<{ path?: string; role?: string; sha256?: string; bytes?: number; alt?: string; caption?: string }>;
  gates?: Record<string, { status?: string; summary?: string }>;
  claim_boundary?: { supports?: string[]; does_not_support?: string[] };
  completion_boundary?: string;
  execution_routes?: ExecutionRoute[];
};

type Figure = { path: string; role: string; sha256: string; alt: string; caption?: string; dataUrl: string };
type Props = { workflow: Workflow; manifest: CaseManifest; excerpt: string; figures: Figure[] };
type HumanGuidance = { interface: string; open: string; inspect: string; decide: string };

export const getStaticPaths: GetStaticPaths = async () => {
  const workflows = workflowsDocument.workflows as Workflow[];
  return Promise.all(workflows.map(async (workflow) => {
    const root = new URL(`../../../examples/cases/${workflow.case_id}/`, import.meta.url);
    try {
      const [readme, manifest, excerpt] = await Promise.all([
        readFile(new URL('README.md', root), 'utf8'),
        readFile(new URL('manifest.json', root), 'utf8'),
        readFile(new URL(workflow.excerpt_path, root), 'utf8'),
      ]);
      if (readme.trim().length === 0) throw new Error('README.md is empty');
      const parsed = JSON.parse(manifest) as CaseManifest;
      const excerptArtifact = (parsed.artifacts ?? []).find((artifact) => artifact.path === workflow.excerpt_path);
      const excerptSha256 = createHash('sha256').update(excerpt).digest('hex');
      if (!excerptArtifact || excerptArtifact.sha256 !== excerptSha256 || excerptArtifact.bytes !== Buffer.byteLength(excerpt)) {
        throw new Error(`excerpt ${workflow.excerpt_path} is not bound by the case manifest hash and byte count`);
      }

      const countReferences = (values: Array<string | undefined>) => {
        const counts = new Map<string, number>();
        for (const value of values) {
          if (value) counts.set(value, (counts.get(value) ?? 0) + 1);
        }
        return counts;
      };
      const routeCounts = countReferences((parsed.execution_routes ?? []).map((route) => route.route_id));
      const commandCounts = countReferences((parsed.commands ?? []).map((command) => command.stage));
      const artifactCounts = countReferences((parsed.artifacts ?? []).map((artifact) => artifact.path));
      const assertSingleReference = (
        kind: string,
        reference: string,
        counts: Map<string, number>,
        owner: string,
      ) => {
        if (counts.get(reference) !== 1) {
          throw new Error(`${owner} references unresolved or ambiguous ${kind} ${reference}`);
        }
      };

      for (const routeId of workflow.continuous_execution_route_ids) {
        assertSingleReference('execution route', routeId, routeCounts, `workflow ${workflow.slug}`);
      }
      for (const stage of workflow.reader_route.stages) {
        for (const routeId of stage.execution_route_ids) {
          assertSingleReference('execution route', routeId, routeCounts, `reader stage ${stage.id}`);
        }
        for (const commandStage of stage.command_stages) {
          assertSingleReference('command stage', commandStage, commandCounts, `reader stage ${stage.id}`);
        }
        for (const artifactPath of stage.artifact_paths) {
          assertSingleReference('artifact', artifactPath, artifactCounts, `reader stage ${stage.id}`);
        }
      }

      const figures = await Promise.all((parsed.artifacts ?? [])
        .filter((artifact) => artifact.path?.startsWith('figures/') && /\.(?:png|webp)$/i.test(artifact.path))
        .map(async (artifact) => {
          const path = artifact.path as string;
          const mime = path.endsWith('.webp') ? 'image/webp' : 'image/png';
          const data = await readFile(new URL(path, root));
          return {
            path,
            role: artifact.role ?? 'Case-derived data figure',
            sha256: artifact.sha256 ?? 'declared in manifest',
            alt: artifact.alt ?? `${workflow.material} data figure generated from the case's hash-bound raw data`,
            caption: artifact.caption,
            dataUrl: `data:${mime};base64,${data.toString('base64')}`,
          };
        }));
      return {
        params: { slug: workflow.slug },
        props: { workflow, manifest: parsed, excerpt, figures } satisfies Props,
      };
    } catch (error) {
      throw new Error(
        `Worked workflow ${workflow.slug} is blocked: its case README, manifest, excerpt, and figures must be readable (${String(error)}).`,
      );
    }
  }));
};

const { workflow, manifest, excerpt, figures } = Astro.props as Props;
const software = (manifest.software ?? [])
  .map((item) => [item.name, item.version, item.interface ? `(${item.interface})` : ''].filter(Boolean).join(' '));
const commands = manifest.commands ?? [];
const executionRoutes = manifest.execution_routes ?? [];
const artifacts = manifest.artifacts ?? [];
const readerStages = workflow.reader_route.stages;
const firstFigureStage = new Map<string, string>();
for (const stage of readerStages) {
  for (const path of stage.artifact_paths) {
    if (figures.some((figure) => figure.path === path) && !firstFigureStage.has(path)) {
      firstFigureStage.set(path, stage.id);
    }
  }
}
const recordConflicts = workflow.record_conflicts ?? [];
const storedEvidenceTracks = workflow.evidence_tracks.filter((track) => !track.launches_dft);
const freshExecutionTracks = workflow.evidence_tracks.filter((track) => track.launches_dft);
const evidenceTrackGroups = [
  {
    id: 'stored',
    label: 'Inspect stored evidence',
    intro: 'This track reads the published, hash-bound case records and does not launch a new DFT calculation.',
    tracks: storedEvidenceTracks,
  },
  {
    id: 'fresh',
    label: 'Run a fresh calculation',
    intro: 'This track launches software in a caller-controlled runtime directory. Its new outputs do not rewrite the historical records published in the case bundle.',
    tracks: freshExecutionTracks,
  },
];

const executionRouteById = new Map<string, ExecutionRoute>();
for (const route of executionRoutes) {
  if (route.route_id) executionRouteById.set(route.route_id, route);
}
const commandIndexByStage = new Map<string, number>();
commands.forEach((command, index) => {
  if (command.stage) commandIndexByStage.set(command.stage, index);
});
const artifactByPath = new Map<string, NonNullable<CaseManifest['artifacts']>[number]>();
for (const artifact of artifacts) {
  if (artifact.path) artifactByPath.set(artifact.path, artifact);
}
const gates = Object.entries(manifest.gates ?? {}).sort(([a], [b]) => a.localeCompare(b));
const gateLabels: Record<string, string> = {
  G0: 'Inputs and identity',
  G1: 'Program completion',
  G2: 'Electronic solver and ionic or structural checks',
  G3: 'Artifacts and stage ancestry',
  G4: 'Observable convergence',
  G5: 'Claim boundary',
};
const gateStatusText = (status?: string) => ({
  PASS: 'Recorded as passed within the stated scope',
  WARN: 'Warnings or limitations are retained',
  FAIL: 'Did not meet the stated check',
  'NOT TESTED': 'Not established by this case',
  'NOT CLAIMED': 'No material-level claim is made',
}[status ?? ''] ?? 'No public status is declared');
const caseRoot = `examples/cases/${workflow.case_id}/`;
const sourceRevision = (() => {
  const declared = process.env.GITHUB_SHA ?? process.env.SOURCE_REVISION;
  if (/^[a-f0-9]{40}$/i.test(declared ?? '')) return declared as string;
  try {
    const local = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
    if (/^[a-f0-9]{40}$/i.test(local)) return local;
  } catch {
    // The explicit error below keeps exact-checkout instructions fail closed.
  }
  throw new Error('Worked workflow rendering requires an exact 40-character source revision.');
})();
const caseFileUrl = (file: string) => `https://github.com/Maxwell3919/DFT-Research-Workflow/blob/${sourceRevision}/${caseRoot}${file}`;
const substituteSourceRevision = (value: string) =>
  value.split(workflow.start_here.source_revision_token).join(sourceRevision);
const commandBlock = (values: string[]) => values.map(substituteSourceRevision).join('\n');
const commandAnchor = (stage: string) => {
  const index = commandIndexByStage.get(stage);
  return index === undefined ? 'commands-heading' : `recorded-command-${index + 1}`;
};
const casePurposeBySlug: Record<string, string> = {
  'silicon-ground-state-electronic-structure': 'Follow a real COD Silicon structure through model inspection, numerical setup, a reference state, bands, DOS, plots, and a bounded scientific interpretation.',
  'aluminium-metallic-electronic-structure': 'Follow an explicit fcc Aluminium teaching model through metallic numerical choices, SCF and full-zone branches, DOS, real convergence and E(V) screens, and a bounded interpretation.',
};
const humanGuidanceByStage: Record<string, HumanGuidance> = {
  source: {
    interface: 'Browser, text editor, and structure viewer.',
    open: 'Open the declared database, paper, or teaching record. Read its composition, cell, provenance, revision, conditions, and access boundary before downloading or converting anything.',
    inspect: 'Read the source structure as text and visualize it. Check periodicity, cell choice, occupancies, missing or disordered sites, short contacts, orientation, and whether the object matches the intended material.',
    decide: 'Accept the source identity for model construction, or return to the database, paper, Supplementary Information, or another source class.',
  },
  model: {
    interface: 'Structure viewer plus a text editor or structure library.',
    open: 'Open both the source structure and the exact computational cell.',
    inspect: 'Compare composition, atom count, lattice, orientation, periodicity, symmetry, vacuum where relevant, and the mapping between conventional, primitive, or modified cells.',
    decide: 'Proceed only when the transformed model still represents the intended physical system and every deliberate modification is recorded.',
  },
  pseudopotential: {
    interface: 'Official library page, metadata, and the exact potential file.',
    open: 'Open the library or file record before using a download command. Read the family, exchange–correlation compatibility, valence configuration, relativistic treatment, provenance, and recommended cutoff information.',
    inspect: 'Compare those choices with the physical method and elements in the model; then retain the exact file identity.',
    decide: 'Choose a compatible family for a controlled convergence study. A matching hash establishes identity, not suitability.',
  },
  inputs: {
    interface: 'Text editor and the official input reference.',
    open: 'Read every input that will be submitted, including the structure, calculation type, physical method, numerical settings, prefix, scratch path, and parent artifacts.',
    inspect: 'Identify which choices came from the scientific model, which are numerical parameters to test, and which paths or defaults are site-specific.',
    decide: 'Submit only an input whose choices and expected outputs you can explain and audit.',
  },
  run: {
    interface: 'Terminal, SSH session, and site scheduler.',
    open: 'Read the launcher or job script, working directory, resource request, output paths, and site policy before submission.',
    inspect: 'Watch scheduler state and the complete stdout/stderr without mistaking new text, a queue state, or a termination marker for scientific convergence.',
    decide: 'Continue, diagnose, or stop only from the identified job, output, ownership, and failure layer.',
  },
  checks: {
    interface: 'Complete raw output, stderr, scheduler record, and expected downstream files.',
    open: 'Open the complete stage, not only a grep result or final line.',
    inspect: 'Read iteration behaviour, warnings, termination context, forces or stress where applicable, and whether the intended artifacts were actually written.',
    decide: 'Classify program completion, solver convergence, optimization convergence, and artifact completeness separately.',
  },
  convergence: {
    interface: 'Numerical table and convergence plot.',
    open: 'Open the calculated series and its predeclared comparison quantity before reading the pass/fail summary.',
    inspect: 'Look for a stable tail, oscillation, state changes, outliers, and whether only one parameter varied while the physical model stayed fixed.',
    decide: 'Accept only the tested observable and tolerance; otherwise extend or redesign the series without erasing the adverse points.',
  },
  'relaxation-reference-geometry': {
    interface: 'Relaxation output, coordinate/force table, and structure viewer.',
    open: 'Open the starting and final structures side by side with the final force, stress, constraint, and optimizer records.',
    inspect: 'Look for unexpected reconstruction, broken symmetry, short contacts, cell distortion, or a visually plausible structure that still fails a numerical criterion.',
    decide: 'Accept the geometry only within the declared optimization conditions; visual plausibility alone is not convergence or stability.',
  },
  scf: {
    interface: 'Reference input, complete SCF output, and iteration history.',
    open: 'Open the state, occupations, spin treatment, energy, residual history, warnings, and parent geometry together.',
    inspect: 'Look for slow or oscillatory convergence, state changes, inconsistent occupations, and whether the output belongs to the accepted model.',
    decide: 'Use the state as a parent only when the electronic criterion and reference-state logic are both adequate.',
  },
  'bands-dos': {
    interface: 'Official post-processing tools, k-space/path record, plots, and underlying tables.',
    open: 'Open the parent SCF/NSCF state, path or full-zone sampling record, energy reference, number of bands, and the resulting bands or DOS data.',
    inspect: 'Check path labels, Fermi reference, crossings or gaps, full-zone limitations, DOS normalization, broadening, warnings, and sampling density.',
    decide: 'Use only the observable supported by the sampled domain and its own convergence evidence; a high-symmetry path is not a full-zone proof.',
  },
  plot: {
    interface: 'Plotting program, notebook, or spreadsheet together with the source table.',
    open: 'Open each real figure beside its underlying calculated values.',
    inspect: 'Check axes, units, reference zeros, calculated points, fits or smoothing, warnings, and features that change with representation.',
    decide: 'Retain figures that expose the scientific evidence and its limitations; a regenerated image is not an independently validated result.',
  },
  interpret: {
    interface: 'Figures, tables, raw anomalies, primary literature, Supplementary Information, and experimental records.',
    open: 'Compare the calculated object with independent calculations or measurements only after matching structure, state, conditions, and observable definition.',
    inspect: 'Look for contradictions, method sensitivity, missing alternatives, and conclusions controlled by an unconverged or untested stage.',
    decide: 'State the narrowest supported claim and the evidence that would change it.',
  },
  preserve: {
    interface: 'Research notebook, files, browser receipts, GUI exports, archive, and reproducibility record.',
    open: 'Collect the human decision history together with sources, inputs, outputs, tables, figures, warnings, failed attempts, and software context.',
    inspect: 'Confirm that another researcher can identify what was done, what was viewed, what was excluded, and which steps can or cannot be reconstructed.',
    decide: 'Freeze a versioned study object while keeping hashes and manifests as supporting identity evidence rather than the scientific narrative.',
  },
};
const humanGuidanceForStage = (stageId: string): HumanGuidance => humanGuidanceByStage[stageId] ?? {
  interface: 'The human interface appropriate to this scientific object.',
  open: 'Open the exact source object and the record that identifies it.',
  inspect: 'Inspect the object, its warnings, and the evidence relevant to this stage.',
  decide: 'Proceed only when the stage supports the next scientific action within its stated boundary.',
};
const sourceHumanAction = (role: string) => role === 'structure'
  ? 'Open the record in a browser when one is declared, read its metadata and source publication, download the structure, inspect the text, and visualize the cell before conversion.'
  : 'Open the official library or file record, inspect method compatibility and metadata, then acquire and preserve the exact file used.';
---

<BaseLayout title={workflow.title} description={workflow.summary} current="workflows">
  <article
    class="chapter"
    data-workflow-slug={workflow.slug}
    data-case-id={workflow.case_id}
    data-history-kind={workflow.history_kind}
    data-evidence-boundary={workflow.evidence_boundary}
    data-continuity-boundary={workflow.continuity_boundary}
    data-claim-boundary={workflow.claim_boundary}
  >
    <p class="breadcrumb"><a href={withBase('workflows/')}>Worked Workflows</a></p>
    <p class="operation-label">Worked research case</p>
    <h1>{workflow.title}</h1>
    <p class="operation-summary">{workflow.summary}</p>

    <section class="article-content" aria-labelledby="research-objective-heading" data-research-objective>
      <h2 id="research-objective-heading">Scientific objective and starting object</h2>
      <p>{casePurposeBySlug[workflow.slug] ?? workflow.summary}</p>
      <p><strong>Current claim boundary:</strong> {workflow.claim_boundary}</p>
      <p>
        Work across the interface that fits the task: use a browser for source records and manuals,
        <a href={withBase('tools/vesta/')}> VESTA or another structure viewer</a> for visual inspection,
        a text editor for inputs, and the terminal or scheduler for execution. The
        <a href={withBase('operations/software-bridge/')}> Software Bridge</a> points users of other codes to their native artifacts.
      </p>
    </section>

    <section class="article-content" aria-labelledby="source-records-heading" data-source-records>
      <h2 id="source-records-heading">Open the starting sources</h2>
      <p>Automated download is optional. First identify what the source represents, what metadata must return with it, and what still requires human inspection.</p>
      {workflow.source_records.map((source) => (
        <div id={`source-record-${source.id}`} data-source-record={source.id}>
          <h3>{source.url ? <a href={source.url}>{source.label}</a> : source.label}</h3>
          <p>{source.role}</p>
          <p><strong>Human action:</strong> {sourceHumanAction(source.role)}</p>
          {!source.url && <p><strong>No external record is declared:</strong> treat this as an explicit teaching model and do not infer database or experimental provenance.</p>}
          <details>
            <summary>Exact source identity and case files</summary>
            {source.case_files.length > 0 && (
              <ul>{source.case_files.map((path) => <li><a href={caseFileUrl(path)}><code>{path}</code></a></li>)}</ul>
            )}
            {source.identity && source.identity.length > 0 && <ul>{source.identity.map((item) => <li>{item}</li>)}</ul>}
          </details>
          <p><strong>Boundary:</strong> {source.boundary}</p>
        </div>
      ))}
    </section>

<section
      class="article-content"
      aria-labelledby="reader-route-heading"
      data-reader-route={workflow.slug}
      data-reader-route-schema-version={workflow.reader_route.schema_version}
    >
      <h2 id="reader-route-heading">Follow the calculation</h2>
      <p>
        At each stage, open the real object, inspect what a researcher would actually look at, make the bounded decision, and then use a command where the terminal is the natural interface. Return to an earlier stage whenever a model, method, reference state, target calculation, or validation check fails. This case order is not a universal DFT sequence.
      </p>
      <ol>
        {readerStages.map((stage, index) => (
          <li
            data-reader-stage={stage.id}
            data-reader-stage-index={index + 1}
            data-topic-slugs={stage.topic_slugs.join(',')}
            data-case-files={stage.case_files.join(',')}
            data-execution-route-ids={stage.execution_route_ids.join(',')}
            data-command-stages={stage.command_stages.join(',')}
            data-artifact-paths={stage.artifact_paths.join(',')}
          >
            <h3 id={`reader-stage-${stage.id}`}>{stage.label}</h3>
            <p>{stage.purpose}</p>

            <div data-human-workflow-step>
              <p>{humanGuidanceForStage(stage.id).open} {humanGuidanceForStage(stage.id).inspect}</p>
              <p><strong>Continue when:</strong> {humanGuidanceForStage(stage.id).decide}</p>
            </div>

            {figures.filter((figure) => firstFigureStage.get(figure.path) === stage.id).map((figure) => (
              <figure data-stage-figure={figure.path}>
                <img src={figure.dataUrl} alt={figure.alt} loading="lazy" />
                <figcaption>
                  {figure.caption ?? figure.role}. Read it together with the source table and the stage boundary below.
                  {' '}<a href={caseFileUrl(figure.path)}>Open the source figure.</a>
                </figcaption>
              </figure>
            ))}

            {stage.action && (
              <div data-reader-stage-action>
                <h4>Run this step: {stage.action.label}</h4>
                <p><strong>Run from:</strong> <code>{substituteSourceRevision(stage.action.cwd)}</code></p>
                <pre data-copyable><code>{commandBlock(stage.action.commands)}</code></pre>
                <p><strong>Boundary:</strong> {substituteSourceRevision(stage.action.boundary)}</p>
              </div>
            )}

            <details data-stage-evidence-details>
              <summary>Exact files and recorded evidence for this stage</summary>
              {stage.topic_slugs.length > 0 && <ul>{stage.topic_slugs.map((topicSlug) => <li data-topic-reference={topicSlug}><a href={withBase(`operations/${topicSlug}/`)}>{topicTitleBySlug.get(topicSlug) ?? "Research Workflow topic"}</a></li>)}</ul>}
              {stage.case_files.length > 0 && <ul>{stage.case_files.map((path) => <li data-case-file-reference={path}><a href={caseFileUrl(path)}><code>{path}</code></a></li>)}</ul>}
              {stage.execution_route_ids.length > 0 && <ul>{stage.execution_route_ids.map((routeId) => <li data-execution-route-reference={routeId}><a href={`#execution-route-${routeId}`}>{executionRouteById.get(routeId)?.label ?? "Recorded execution route"}</a></li>)}</ul>}
              {stage.command_stages.length > 0 && <ul>{stage.command_stages.map((commandStage) => <li data-command-stage-reference={commandStage}><a href={`#${commandAnchor(commandStage)}`}><code>{commandStage}</code></a></li>)}</ul>}
              {stage.artifact_paths.length > 0 && <ul>{stage.artifact_paths.map((path) => <li data-artifact-reference={path}><a href={caseFileUrl(path)}><code>{path}</code></a>{' — '}{artifactByPath.get(path)?.role ?? 'manifest artifact'}; SHA-256 <code>{artifactByPath.get(path)?.sha256 ?? 'not declared'}</code></li>)}</ul>}
            </details>

            {stage.assessment && <p data-stage-assessment><strong>Assessment:</strong> {stage.assessment}</p>}
            {stage.observable_convergence && <p data-observable-convergence><strong>Observable convergence:</strong> {stage.observable_convergence}</p>}
            <p><strong>Boundary:</strong> {stage.boundary}</p>
          </li>
        ))}
      </ol>
    </section>

    <details class="workflow-reproducibility" data-reproducibility-appendix>
      <summary>Reproducibility appendix</summary>
      <p>Open this only when you need the exact published case record, hashes, historical commands, or replay boundary.</p>

<section class="article-content" aria-labelledby="case-scope-heading" data-case-evidence-scope>
      <h2 id="case-scope-heading">How to use this workflow</h2>
      <dl>
        <dt>Evidence boundary</dt>
        <dd>{workflow.evidence_boundary}</dd>
        <dt>Continuity boundary</dt>
        <dd>{workflow.continuity_boundary}</dd>
        <dt>Claim boundary</dt>
        <dd>{workflow.claim_boundary}</dd>
      </dl>
      {workflow.continuous_execution_route_ids.length > 0 && (
        <>
          <h3>Declared continuous execution routes</h3>
          <ul>
            {workflow.continuous_execution_route_ids.map((routeId) => (
              <li data-continuous-execution-route-reference={routeId}>
                <a href={`#execution-route-${routeId}`}>
                  {executionRouteById.get(routeId)?.label ?? routeId}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section class="article-content" aria-labelledby="execution-contexts-heading" data-execution-contexts>
      <h2 id="execution-contexts-heading">Execution contexts</h2>
      <dl>
        {workflow.execution_contexts.map((context) => (
          <>
            <dt data-execution-context={context.id}>{context.label}</dt>
            <dd>
              <strong>Use when:</strong> {context.allowed_when}.{' '}
              <strong>Boundary:</strong> {context.boundary}
            </dd>
          </>
        ))}
      </dl>
    </section>

    <section class="article-content" aria-labelledby="evidence-tracks-heading" data-evidence-tracks>
      <h2 id="evidence-tracks-heading">Inspect stored evidence or run a fresh calculation</h2>
      {evidenceTrackGroups.map((group) => group.tracks.length > 0 && (
        <section aria-labelledby={`evidence-track-group-${group.id}`} data-evidence-track-group={group.id}>
          <h3 id={`evidence-track-group-${group.id}`}>{group.label}</h3>
          <p>{group.intro}</p>
          {group.tracks.map((track) => (
            <div data-evidence-track={track.id} data-launches-dft={String(track.launches_dft)}>
              <h4>{track.label}</h4>
              {track.commands.length > 0 && <pre><code>{commandBlock(track.commands)}</code></pre>}
              <p><strong>Output policy:</strong> {track.output_policy}</p>
              {track.audit.length > 0 && (
                <>
                  <p><strong>Audit</strong></p>
                  <ul>{track.audit.map((item) => <li>{item}</li>)}</ul>
                </>
              )}
              <p><strong>Parse and plot boundary:</strong> {track.parse_plot_boundary}</p>
              <p><strong>Boundary:</strong> {track.boundary}</p>
            </div>
          ))}
        </section>
      ))}
    </section>

    {recordConflicts.length > 0 && (
      <section class="article-content" aria-labelledby="record-conflicts-heading" data-record-conflicts>
        <h2 id="record-conflicts-heading">Retained record conflicts</h2>
        {recordConflicts.map((conflict) => (
          <div data-record-conflict={conflict.id}>
            <p><strong>Record note</strong></p>
            <ul>
              {conflict.case_files.map((path) => (
                <li data-conflicting-case-file-reference={path}>
                  <a href={caseFileUrl(path)}><code>{path}</code></a>
                </li>
              ))}
            </ul>
            <p>
              <strong>Preferred record:</strong>{' '}
              <a href={caseFileUrl(conflict.preferred_record)}><code>{conflict.preferred_record}</code></a>
            </p>
            <p><strong>Boundary:</strong> {conflict.boundary}</p>
          </div>
        ))}
      </section>
    )}
    <section class="article-content" aria-labelledby="start-here-heading" data-start-here data-reproduction-section>
      <h2 id="start-here-heading">Reproduce the exact published evidence</h2>
      <p>Use this section after understanding the scientific route. It retrieves the exact reviewed checkout and keeps new runtime evidence separate from the published case.</p>
      <p><strong>Repository:</strong>{' '}<a href={substituteSourceRevision(workflow.start_here.repository_url)}>{substituteSourceRevision(workflow.start_here.repository_url)}</a></p>
      <p><strong>Source revision:</strong> <code>{sourceRevision}</code></p>
      <p><strong>Working directory:</strong> <code>{workflow.start_here.working_directory}</code></p>
      <p><strong>Case root:</strong> <code>{workflow.start_here.case_root}</code></p>
      <pre data-copyable><code>{commandBlock(workflow.start_here.acquisition_commands)}</code></pre>
      <h3>{workflow.start_here.first_action.label}</h3>
      <p><strong>Run from:</strong> <code>{substituteSourceRevision(workflow.start_here.first_action.cwd)}</code></p>
      <pre data-copyable><code>{commandBlock(workflow.start_here.first_action.commands)}</code></pre>
      <p><strong>Boundary:</strong> {substituteSourceRevision(workflow.start_here.first_action.boundary)}</p>
    </section>

    <section class="article-content" aria-labelledby="case-bundle-heading">
      <h2 id="case-bundle-heading">Exact case bundle files</h2>
      <p>
        This page is a reader-facing entry point for the case directory. Inspect the files themselves for the exact source record, input, command scope, raw or sanitized output, checks, extraction, parser, derived data, and figure lineage.
      </p>
      <ul>
        <li><a href={caseFileUrl('README.md')}>Case README</a></li>
        <li><a href={caseFileUrl('manifest.json')}>Execution manifest</a></li>
        <li><a href={caseFileUrl('run.sh')}>Native replay template</a></li>
        <li><a href={caseFileUrl('check.sh')}>Case-local isolated check</a></li>
        <li><a href={caseFileUrl('parse.py')}>Strict parser</a></li>
        <li><a href={caseFileUrl(workflow.excerpt_path)}>Hash-bound output excerpt</a></li>
      </ul>
    </section>

    <section class="article-content" aria-labelledby="commands-heading">
      <h2 id="commands-heading">Recorded commands and outputs</h2>
      <p>
        These records distinguish captured output, replay instructions, and unavailable historical shell details. Records may belong to different declared routes; adjacency on this page does not establish one continuous run. An exit is shown only when the manifest scopes where that value came from, and a QE terminal marker is not silently converted into a shell exit code.
      </p>
      {manifest.completion_boundary && <p><strong>Case-wide timing boundary:</strong> {manifest.completion_boundary}</p>}
      {executionRoutes.map((route) => (
        <div
          id={route.route_id ? `execution-route-${route.route_id}` : undefined}
          data-execution-route-id={route.route_id}
        >
          <p><strong>{route.label ?? route.route_id ?? 'Execution route'}</strong></p>
          {route.route_id && <p><strong>Route ID:</strong> <code>{route.route_id}</code></p>}
          {route.timing && <p><strong>Route timing:</strong> {route.timing.started_at ?? 'start not recorded'} to {route.timing.completed_at ?? 'completion not recorded'}. {route.timing.scope}</p>}
          {route.exact_command_status && <p><strong>Exact historical command:</strong> {route.exact_command_status}</p>}
          {route.exact_exit_code_status && <p><strong>Exact historical exit:</strong> {route.exact_exit_code_status}</p>}
          {route.ancestry && route.ancestry.length > 0 && <ul>{route.ancestry.map((item) => <li>{item}</li>)}</ul>}
          {route.boundary && <p><strong>Boundary:</strong> {route.boundary}</p>}
        </div>
      ))}
      {commands.map((entry, index) => (
        <div id={`recorded-command-${index + 1}`} data-command-stage={entry.stage}>
          <p><strong>{entry.stage ?? 'Recorded stage'} · {typeof entry.exit_code === 'number' ? `exit ${entry.exit_code}` : 'exit not recorded'}</strong></p>
          {entry.route_id && <p><strong>Route:</strong> <code>{entry.route_id}</code></p>}
          {entry.record_kind && <p><strong>Record kind:</strong> {entry.record_kind}</p>}
          <pre><code>{entry.command ?? 'See manifest'}</code></pre>
          {entry.evidence_scope && <p><strong>Evidence scope:</strong> {entry.evidence_scope}</p>}
          {entry.exit_code_scope && <p><strong>Exit scope:</strong> {entry.exit_code_scope}</p>}
          {entry.input_artifacts && entry.input_artifacts.length > 0 && <p><strong>Inputs:</strong> <code>{entry.input_artifacts.join(' -> ')}</code></p>}
          {entry.parent_artifacts && entry.parent_artifacts.length > 0 && <p><strong>Declared parents:</strong> <code>{entry.parent_artifacts.join(' -> ')}</code></p>}
          {entry.output_artifacts && entry.output_artifacts.length > 0 && <p><strong>Outputs:</strong> <code>{entry.output_artifacts.join(' -> ')}</code></p>}
        </div>
      ))}
      <p><strong>Source-bound excerpt: {workflow.excerpt_path}</strong></p>
      <pre><code>{excerpt.trimEnd()}</code></pre>
    </section>

    <section class="article-content" aria-labelledby="artifacts-heading" data-artifact-appendix>
      <h2 id="artifacts-heading">Complete artifact appendix</h2>
      <p>
        Stage-scoped lists above identify only the artifacts critical for reading each stage. This appendix retains every artifact declared by the case manifest, including supporting inputs, outputs, checks, tables, and figures.
      </p>
      <details>
        <summary>Show every manifest-bound artifact and checksum</summary>
        <ul>
          {artifacts.map((artifact) => (
            <li data-artifact-path={artifact.path}>
              <a href={caseFileUrl(artifact.path ?? '')}>{artifact.path}</a>
              {' — '}{artifact.role ?? 'declared artifact'}; SHA-256 <code>{artifact.sha256 ?? 'not declared'}</code>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="article-content" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading">Evidence boundary</h2>
      <p><strong>Evidence class:</strong> {manifest.evidence_class ?? 'declared in the case manifest'}.</p>
      {software.length > 0 && <ul>{software.map((item) => <li>{item}</li>)}</ul>}
      {manifest.public_host_label && <p><strong>Execution host:</strong> {manifest.public_host_label}.</p>}
      <dl>
        {gates.map(([gate, record]) => (
          <><dt>{gateLabels[gate] ?? 'Additional evidence boundary'}</dt><dd><strong>{gateStatusText(record.status)}</strong>. {record.summary ?? 'No summary declared.'}</dd></>
        ))}
      </dl>
      <h3>What this case supports</h3>
      <ul>{(manifest.claim_boundary?.supports ?? []).map((claim) => <li>{claim}</li>)}</ul>
      <h3>What this case does not support</h3>
      <ul>{(manifest.claim_boundary?.does_not_support ?? []).map((claim) => <li>{claim}</li>)}</ul>
      <p>
        Program completion, solver convergence, observable convergence, and physical interpretation are separate gates. The case check and parser report their tested scope; an absent gate is not implied by a passing earlier one.
      </p>
    </section>

    <section class="article-content" aria-labelledby="workflow-context-heading">
      <h2 id="workflow-context-heading">Research-workflow context</h2>
      <p>
        Use this case together with <a href={withBase('operations/')}>Research Workflow</a> for the A–E scientific map. The case illustrates one bounded case and its declared routes; it does not prescribe parameters or establish a general material conclusion.
      </p>
    </section>
    </details>

    <p class="directory-link"><a href={withBase('workflows/')}>Return to Worked Workflows</a></p>
  </article>
</BaseLayout>
