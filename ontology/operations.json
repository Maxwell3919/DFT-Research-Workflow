_portability_tests","dependencies":["O05","O07"],"alternatives":["plane_wave_PAW","pseudopotential","local_orbital","all_electron","real_space"],"exclusions":["acceptance_criteria","scheduler_configuration"]},{"id":"O09","order":9,"slug":"o09-design-the-protocol-references-and-acceptance-criteria","name":"Design the Protocol, References, and Acceptance Criteria","lifecycle":"protocol-design","definition":"Define workflow dependencies, reference states, convergence axes, target observables, tolerances, and evidence gates before execution.","inputs":["scientific_target","scientific_claim","model_specification","method_specification","numerical_specification"],"outputs":["workflow_protocol","reference_scheme","convergence_plan","acceptance_criteria"],"requirement":"required","repeatability":"on_evidence_gap_or_scope_change","dependencies":["O05","O07","O08"],"alternatives":["manual_protocol","workflow_template","adaptive_protocol"],"exclusions":["executable_input_files","actual_validation_results"]},{"id":"O10","order":10,"slug":"o10-materialize-and-preflight-executable-inputs","name":"Materialize and Preflight Executable Inputs","lifecycle":"protocol-design","definition":"Compile the model and protocol into code-specific, post-processing, and scheduler inputs and perform static consistency checks.","inputs":["computational_model","method_specification","numerical_specification","workflow_protocol"],"outputs":["executable_input_bundle","dependency_manifest","preflight_report"],"requirement":"required_per_executable_node","repeatability":"per_parameter_revision","dependencies":["O05","O07","O08","O09"],"alternatives":["code_native_generator","workflow_plugin","templated_generator"],"exclusions":["runtime_execution","scientific_convergence"]},{"id":"O11","order":11,"slug":"o11-configure-the-execution-environment-and-resources","name":"Configure the Execution Environment and Resources","lifecycle":"computation","definition":"Fix executable versions, libraries, runtime environment, parallel layout, storage, and requested resources.","inputs":["executable_input_bundle","target_computer"],"outputs":["environment_manifest","resource_request","scheduler_configuration"],"requirement":"required_for_execution","repeatability":"per_platform_or_resource_change","dependencies":["O10"],"alternatives":["module_environment","container","virtual_environment","static_binary"],"exclusions":["scientific_method_selection","result_validation"]},{"id":"O12","order":12,"slug":"o12-orchestrate-monitor-and-recover-executions","name":"Orchestrate, Monitor, and Recover Executions","lifecycle":"computation","definition":"Submit and control tasks, interpret runtime states, retry recoverable failures, restart work, and update dependencies.","inputs":["workflow_protocol","executable_input_bundle","environment_manifest"],"outputs":["execution_record","exit_state","error_events","restart_artifacts","revised_tasks"],"requirement":"required_for_executed_workflows","repeatability":"highly_repeated","dependencies":["O09","O10","O11"],"alternatives":["manual_execution","scheduler_script","workflow_engine"],"exclusions":["electronic_state_semantics","physical_validation"]},{"id":"O13","order":13,"slug":"o13-solve-an-electronic-state","name":"Solve an Electronic State","lifecycle":"computation","definition":"Solve a ground-state, non-self-consistent, constrained, or otherwise specified electronic-state problem for fixed nuclear variables.","inputs":["computational_model","method_specification","numerical_specification","executable_context"],"outputs":["density","orbitals_or_wavefunctions","eigenvalues","energy","forces","stress","electronic_metadata"],"requirement":"core_for_most_workflows","repeatability":"repeated_across_states_parameters_and_iterations","dependencies":["O07","O08","O10","O11","O12"],"alternatives":["SCF","NSCF","direct_minimization","constrained_state"],"exclusions":["ionic_optimization","trajectory_propagation","scientific_interpretation"]},{"id":"O1