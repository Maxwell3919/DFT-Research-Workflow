{"ontology":{"id":"dft-research-operations","version":"0.2.0-draft","scope_start":"acquisition_selection_or_construction_of_material_structures","scope_end":"claim_assessed_reproducibility_ready_results","granularity":"independently_executable_typed_research_actions","equivalence_rule":"same_primary_action_semantics_and_output_type","minimality_statement":"Scope-bounded canonical set; not a uniquely proven global minimum.","workflow_model":["typed_data_and_provenance_DAG","cyclic_workflow_control_state_graph","lifecycle_x_operation_x_tags_multi_axis_ontology"],"lifecycle_order":["source-and-identity","model-preparation","protocol-design","computation","analysis-and-comparison","evidence-and-claim","preservation"],"cross_cutting_operations":["O09","O12","O20","O21","O22","O23","O24"]},"operations":[{"id":"O01","order":1,"slug":"o01-acquire-source-objects","name":"Acquire Source Objects","lifecycle":"source-and-identity","definition":"Obtain structures and reference artifacts while preserving persistent source identity.","inputs":["query","identifier","file_location","chemical_formula","crystal_prototype"],"outputs":["source_artifact","source_metadata","citation","license_record","checksum"],"requirement":"required","repeatability":"on_source_or_version_change","dependencies":[],"alternatives":["database_query","literature_extraction","experimental_file_import","structure_generator"],"exclusions":["format_parsing","structure_repair","model_construction"]},{"id":"O02","order":2,"slug":"o02-parse-and-normalize-artifacts","name":"Parse and Normalize Artifacts","lifecycle":"source-and-identity","definition":"Convert external representations into typed objects with explicit schemas and units.","inputs":["source_artifact","raw_input_file","raw_output_file","database_record"],"outputs":["typed_object","normalized_units","parse_report"],"requirement":"required_for_external_or_raw_artifacts","repeatability":"per_artifact_format_and_version","dependencies":["O01"],"alternatives