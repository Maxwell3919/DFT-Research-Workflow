{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxwell3919.github.io/DFT-Research-Workflow/schemas/case-manifest-1.0.json",
  "title": "DFT Research Workflow terminal-first case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "case_kind",
    "evidence_class",
    "public_host_label",
    "software",
    "sources",
    "commands",
    "artifacts",
    "gates",
    "claim_boundary"
  ],
  "dependentRequired": {
    "completion_boundary": ["execution_routes"],
    "execution_routes": ["completion_boundary"]
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "case_kind": {
      "enum": ["database-retrieval", "structure-operation", "calculation", "gui-walkthrough", "worked-workflow"]
    },
    "evidence_class": {
      "enum": ["real-execution", "derived-public-data", "real-interface-walkthrough"]
    },
    "public_host_label": { "type": "string", "minLength": 1 },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "completion_boundary": { "type": "string", "minLength": 1 },
    "execution_routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/executionRoute" }
    },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "interface": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "raw_sha256": { "$ref": "#/$defs/sha256" },
          "sanitization": { "type": "string" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "registry_url": { "type": "string", "format": "uri" },
          "exact_url_status": { "type": "string", "minLength": 1 },
          "header_generator": { "type": "string", "minLength": 1 },
          "verified_at": { "type": "string", "format": "date" },
          "verified_bytes": { "type": "integer", "minimum": 1 },
          "accessed_at": { "type": "string", "format": "date" },
          "licence_boundary": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "url": { "type": "null" } },
              "required": ["url"]
            },
            "then": { "required": ["exact_url_status"] }
          },
          {
            "if": { "required": ["registry_url"] },
            "then": { "required": ["exact_url_status"] }
          },
          {
            "if": {
              "anyOf": [
                { "required": ["header_generator"] },
                { "required": ["verified_at"] },
                { "required": ["verified_bytes"] }
              ]
            },
            "then": {
              "required": ["url", "header_generator", "verified_at", "verified_bytes"],
              "properties": { "url": { "type": "string", "format": "uri", "minLength": 1 } }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "command", "exit_code"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": ["integer", "null"] },
          "route_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "record_kind": {
            "enum": [
              "existing-route-execution-record",
              "recorded-output-only",
              "replay-command-not-executed-by-this-edit",
              "available-command-not-rerun-by-this-edit",
              "isolated-copy-check-command-not-rerun-by-this-edit"
            ]
          },
          "evidence_scope": { "type": "string", "minLength": 1 },
          "exit_code_scope": { "type": "string", "minLength": 1 },
          "input_artifacts": { "$ref": "#/$defs/provenanceArtifactPaths" },
          "output_artifacts": { "$ref": "#/$defs/provenanceArtifactPaths" },
          "parent_artifacts": { "$ref": "#/$defs/provenanceArtifactPaths" }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "required": ["route_id"] },
                { "required": ["record_kind"] },
                { "required": ["evidence_scope"] },
                { "required": ["exit_code_scope"] },
                { "required": ["input_artifacts"] },
                { "required": ["output_artifacts"] },
                { "required": ["parent_artifacts"] }
              ]
            },
            "then": {
              "required": ["route_id", "record_kind", "evidence_scope", "exit_code_scope"],
              "anyOf": [
                { "required": ["input_artifacts"] },
                { "required": ["output_artifacts"] },
                { "required": ["parent_artifacts"] }
              ]
            }
          }
        ]
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parser_args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "raw_sha256": { "$ref": "#/$defs/sha256" },
          "sanitization": { "type": "string" },
          "alt": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G0", "G1", "G2", "G3", "G4", "G5"],
      "properties": {
        "G0": { "$ref": "#/$defs/gate" },
        "G1": { "$ref": "#/$defs/gate" },
        "G2": { "$ref": "#/$defs/gate" },
        "G3": { "$ref": "#/$defs/gate" },
        "G4": { "$ref": "#/$defs/gate" },
        "G5": { "$ref": "#/$defs/gate" }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": { "type": "array", "items": { "type": "string" } },
        "does_not_support": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "provenanceArtifactPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "executionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "label",
        "timing",
        "exact_command_status",
        "exact_exit_code_status",
        "ancestry",
        "boundary"
      ],
      "properties": {
        "route_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at", "scope"],
          "properties": {
            "started_at": { "type": ["string", "null"], "format": "date-time" },
            "completed_at": { "type": ["string", "null"], "format": "date-time" },
            "scope": { "type": "string", "minLength": 1 }
          }
        },
        "exact_command_status": { "type": "string", "minLength": 1 },
        "exact_exit_code_status": { "type": "string", "minLength": 1 },
        "ancestry": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "WARN", "NOT TESTED", "NOT CLAIMED"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
