{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxwell3919.github.io/DFT-Research-Workflow/schemas/case-manifest-1.0.json",
  "title": "DFT Research Workflow terminal-first case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "case_kind",
    "evidence_class",
    "public_host_label",
    "software",
    "sources",
    "commands",
    "artifacts",
    "gates",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "case_kind": {
      "enum": ["database-retrieval", "structure-operation", "calculation", "gui-walkthrough", "worked-workflow"]
    },
    "evidence_class": {
      "enum": ["real-execution", "derived-public-data", "real-interface-walkthrough"]
    },
    "public_host_label": { "type": "string", "minLength": 1 },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "interface": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "url": { "type": "string", "format": "uri" },
          "accessed_at": { "type": "string", "format": "date" },
          "licence_boundary": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "command", "exit_code"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "raw_sha256": { "$ref": "#/$defs/sha256" },
          "sanitization": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G0", "G1", "G2", "G3", "G4", "G5"],
      "properties": {
        "G0": { "$ref": "#/$defs/gate" },
        "G1": { "$ref": "#/$defs/gate" },
        "G2": { "$ref": "#/$defs/gate" },
        "G3": { "$ref": "#/$defs/gate" },
        "G4": { "$ref": "#/$defs/gate" },
        "G5": { "$ref": "#/$defs/gate" }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": { "type": "array", "items": { "type": "string" } },
        "does_not_support": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "WARN", "NOT TESTED", "NOT CLAIMED"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
