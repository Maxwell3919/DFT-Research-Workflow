  "scope_note": "Each topic points to one official or maintained-project source already under scientific review, an optional specialist source when it changes interpretation or claim limits, and at most one textbook role. These references support deeper checking; they are not prerequisites for using the operational page.",
  "textbooks": {
    "martin": {
      "citation": "Richard M. Martin, Electronic Structure: Basic Theory and Practical Methods, second edition, Cambridge University Press (2020).",
      "role": "Use for formal meaning, relationships between electronic-structure methods, and limits on what a result can support.",
      "do_not_copy": "Do not copy derivations, equations, chapter prose, figures, or the book's teaching sequence."
    },
    "sholl-steckel": {
      "citation": "David S. Sholl and Janice A. Steckel, Density Functional Theory: A Practical Introduction, Wiley (2009).",
      "role": "Use for practical plane-wave DFT reasoning, controlled comparisons, convergence design, and the distinction between numerical convergence and physical accuracy.",
      "do_not_copy": "Do not copy worked exercises, examples, figures, chapter prose, or parameter recommendations without a page-specific test."
    },
    "giustino": {
      "citation": "Feliciano Giustino, Materials Modelling Using Density Functional Theory: Properties and Predictions, Oxford University Press (2014).",
      "role": "Use to connect theory to measurable materials properties and to identify the calculation and validation needed for a target observable.",
      "do_not_copy": "Do not copy derivations, examples, figures, chapter prose, or a textbook workflow as a universal calculation protocol."
    }
  },
